{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 3,
      "description": "Documentation payload protocol version; schema 3 drops the format version from schema 2's independent version matrix."
    },
    "product_version": {
      "type": "string",
      "description": "Product version of the generating compiler.",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "source_commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$",
      "description": "Generating Git commit, or null outside Git."
    },
    "working_tree_dirty": {
      "type": "boolean",
      "description": "Whether the generating checkout differs from its index or has unknown files."
    },
    "status": {
      "type": "string",
      "enum": [
        "development / release candidate",
        "released"
      ],
      "description": "Release identity verified against a matching clean Git tag."
    },
    "tag": {
      "type": [
        "string",
        "null"
      ],
      "description": "Matching release tag, or null."
    },
    "builtin_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Number of exported builtin names."
    },
    "example_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Number of registered language cases."
    },
    "headings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6,
            "description": "Markdown heading level."
          },
          "title": {
            "type": "string",
            "description": "Original heading text.",
            "minLength": 1
          },
          "anchor": {
            "type": "string",
            "description": "Unique generated HTML anchor.",
            "minLength": 1
          }
        },
        "required": [
          "level",
          "title",
          "anchor"
        ],
        "additionalProperties": true,
        "description": "A generated handbook navigation heading."
      },
      "description": "Ordered handbook headings.",
      "minItems": 1
    },
    "source_files": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*[\\\\\\u0000])[^/]+(?:/[^/]+)*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "description": "Safe relative source paths mapped to SHA-256 content digests."
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*[\\\\\\u0000])[^/]+(?:/[^/]+)*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "description": "Every payload path and its SHA-256; the manifest itself is excluded."
    },
    "language_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "Source-language acceptance version."
    },
    "c_api_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "Bundled C header feature version."
    },
    "c_abi_soversion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "C ABI loader identity from CAbi.cmake."
    }
  },
  "required": [
    "schema_version",
    "product_version",
    "source_commit",
    "working_tree_dirty",
    "status",
    "tag",
    "builtin_count",
    "example_count",
    "headings",
    "source_files",
    "files",
    "language_version",
    "c_api_version",
    "c_abi_soversion"
  ],
  "additionalProperties": true,
  "description": "Documentation identity, independent version matrix and content hashes.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "infinite-props documentation-manifest schema 2",
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "released"
          }
        }
      },
      "then": {
        "properties": {
          "working_tree_dirty": {
            "const": false
          },
          "source_commit": {
            "type": "string"
          },
          "tag": {
            "type": "string",
            "pattern": "^v\\d+\\.\\d+\\.\\d+$"
          }
        }
      },
      "else": {
        "properties": {
          "tag": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {}
}
