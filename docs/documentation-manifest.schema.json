        "headings",
        "source_files",
        "files"
      ],
      "additionalProperties": true,
      "description": "Explicit frozen 0.4 documentation manifest schema 1, never selected by missing current fields.",
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "released"
              }
            }
          },
          "then": {
