{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2,
      "description": "Language export protocol version, independent of language and product versions."
    },
    "product_version": {
      "type": "string",
      "description": "Product build version.",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "language_version": {
      "$ref": "#/$defs/version",
      "description": "Source-language acceptance version."
    },
    "format_version": {
      "$ref": "#/$defs/version",
      "description": "Emitted binary format version."
    },
    "c_api_version": {
      "$ref": "#/$defs/version",
      "description": "Public C API version."
    },
    "abi_version": {
      "$ref": "#/$defs/version",
      "description": "Runtime C library ABI line as major/minor; the structured form of c_abi_soversion, matching iprop_library_query abi_major/abi_minor."
    },
    "c_abi_soversion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "SOVERSION of the bundled runtime C library, configured independently of the product, C API and format versions; equals abi_version major.minor. Optional additive alias since schema 1; producers emit it and readers validate consistency when present."
    },
    "source_rules": {
      "type": "object",
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_type": {
                "type": "string",
                "enum": [
                  "color",
                  "f32",
                  "i32",
                  "u32"
                ],
                "description": "Accepted input declaration spelling."
              },
              "binary_type": {
                "type": "string",
                "enum": [
                  "color",
                  "f32",
                  "u32"
                ],
                "description": "Stored binary input type; signed i32 retains U32 storage."
              },
              "value_type": {
                "type": "string",
                "enum": [
                  "color",
                  "f32",
                  "i32"
                ],
                "description": "Expression value type after loading the input."
              }
            },
            "required": [
              "source_type",
              "binary_type",
              "value_type"
            ],
            "additionalProperties": true,
            "description": "Source, binary storage and expression type mappings."
          },
          "description": "Source, binary storage and expression type mappings.",
          "minItems": 1
        },
        "types": {
          "type": "object",
          "properties": {
            "storable": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "color",
                  "distribution",
                  "f32",
                  "i32",
                  "vec2"
                ],
                "description": "Types accepted by local values and uniform expression values."
              },
              "description": "Types accepted by local values and uniform expression values.",
              "uniqueItems": true,
              "minItems": 1
            },
            "helper_parameters": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "color",
                  "distribution",
                  "f32",
                  "i32",
                  "vec2"
                ],
                "description": "Types accepted in typed helper parameters."
              },
              "description": "Types accepted in typed helper parameters.",
              "uniqueItems": true,
              "minItems": 1
            },
            "helper_value_returns": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "color",
                  "distribution",
                  "f32",
                  "i32",
                  "vec2"
                ],
                "description": "Types accepted by value-returning helpers."
              },
              "description": "Types accepted by value-returning helpers.",
              "uniqueItems": true,
              "minItems": 1
            },
            "output_only_geometry": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "circle",
                  "rect"
                ],
                "description": "Geometry constructors accepted only for declared output writes."
              },
              "description": "Geometry constructors accepted only for declared output writes.",
              "uniqueItems": true,
              "minItems": 1
            },
            "point_value_type": {
              "type": "string",
              "enum": [
                "vec2"
              ],
              "description": "Value type returned by the point constructor."
            },
            "implicit_widening": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string",
                    "enum": [
                      "i32"
                    ],
                    "description": "Source conversion type."
                  },
                  "to": {
                    "type": "string",
                    "enum": [
                      "f32"
                    ],
                    "description": "Destination conversion type."
                  },
                  "contexts": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "call_arguments",
                        "helper_returns",
                        "numeric_operands"
                      ],
                      "description": "Language contexts that permit this conversion."
                    },
                    "description": "Language contexts that permit this conversion.",
                    "uniqueItems": true,
                    "minItems": 1
                  }
                },
                "required": [
                  "from",
                  "to",
                  "contexts"
                ],
                "additionalProperties": true,
                "description": "Permitted implicit conversion edges."
              },
              "description": "Permitted implicit conversion edges.",
              "minItems": 1
            },
            "local_reassignment": {
              "type": "string",
              "enum": [
                "exact_type"
              ],
              "description": "Reassignment requires the previously inferred exact local type."
            },
            "components": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "vec2",
                      "color"
                    ],
                    "description": "Value type whose members can be read with '.name'."
                  },
                  "names": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "description": "Member name after the dot."
                    },
                    "description": "Readable member names in their stored order.",
                    "uniqueItems": true,
                    "minItems": 1
                  },
                  "result": {
                    "type": "string",
                    "enum": [
                      "f32",
                      "i32"
                    ],
                    "description": "Value type of each member read."
                  },
                  "assignable": {
                    "type": "boolean",
                    "const": false,
                    "description": "Members are values; assigning to one is rejected."
                  },
                  "opcodes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "description": "Instruction mnemonic of the member at the same position."
                    },
                    "description": "Instruction mnemonics, one per name; reads of constant values may fold.",
                    "minItems": 1
                  },
                  "minimum_format_minor": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 255,
                    "description": "Oldest binary format minor containing these instructions."
                  }
                },
                "required": [
                  "type",
                  "names",
                  "result",
                  "assignable",
                  "opcodes",
                  "minimum_format_minor"
                ],
                "additionalProperties": true,
                "description": "Read-only member access of one value type; the base evaluates once and draws no randomness."
              },
              "description": "Optional capability list added in source language 0.6. Earlier schema-2 exports omit it; absence does not mean member access is unsupported.",
              "minItems": 1
            }
          },
          "required": [
            "storable",
            "helper_parameters",
            "helper_value_returns",
            "output_only_geometry",
            "point_value_type",
            "implicit_widening",
            "local_reassignment"
          ],
          "additionalProperties": true,
          "description": "Accepted source value categories and conversions."
        },
        "locals": {
          "type": "object",
          "properties": {
            "declaration": {
              "type": "string",
              "enum": [
                "first_assignment"
              ],
              "description": "Construct that introduces a local variable."
            },
            "scope": {
              "type": "string",
              "enum": [
                "function"
              ],
              "description": "Local scope boundary."
            },
            "type_inference_order": {
              "type": "string",
              "enum": [
                "source_traversal"
              ],
              "description": "Traversal order used to establish a local type."
            },
            "definite_assignment_analysis": {
              "type": "boolean",
              "description": "Whether paths undergo definite-assignment analysis."
            },
            "unexecuted_initializer": {
              "type": "string",
              "enum": [
                "typed_zero"
              ],
              "description": "Value observed when the declaring assignment did not execute."
            },
            "read_requires_prior_assignment": {
              "type": "boolean",
              "description": "A read must follow its first assignment in source traversal."
            }
          },
          "required": [
            "declaration",
            "scope",
            "type_inference_order",
            "definite_assignment_analysis",
            "unexecuted_initializer",
            "read_requires_prior_assignment"
          ],
          "additionalProperties": true,
          "description": "Legacy first-assignment local semantics."
        },
        "visibility": {
          "type": "object",
          "properties": {
            "uniforms": {
              "type": "string",
              "enum": [
                "draw_only"
              ],
              "description": "Context where imported or root inputs are readable."
            },
            "uniforms_read_only": {
              "type": "boolean",
              "description": "Inputs cannot be assigned by the program."
            },
            "helper_parameters_read_only": {
              "type": "boolean",
              "description": "Helper parameters cannot be reassigned."
            },
            "draw_controls": {
              "type": "object",
              "properties": {
                "names": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "a",
                      "v"
                    ],
                    "description": "Visible control names."
                  },
                  "description": "Visible control names.",
                  "uniqueItems": true,
                  "minItems": 1
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "i32"
                  ],
                  "description": "Control value type."
                },
                "read_only": {
                  "type": "boolean",
                  "description": "Controls cannot be reassigned."
                }
              },
              "required": [
                "names",
                "type",
                "read_only"
              ],
              "additionalProperties": true,
              "description": "Draw-only implicit control values."
            },
            "seed": {
              "type": "string",
              "enum": [
                "current_rng_state_in_all_functions"
              ],
              "description": "seed reads the current RNG state in every function."
            },
            "palettes": {
              "type": "string",
              "enum": [
                "all_asset_functions"
              ],
              "description": "Asset function contexts where palettes are visible."
            }
          },
          "required": [
            "uniforms",
            "uniforms_read_only",
            "helper_parameters_read_only",
            "draw_controls",
            "seed",
            "palettes"
          ],
          "additionalProperties": true,
          "description": "Function contexts that expose uniforms and read-only values."
        },
        "named_calls": {
          "type": "object",
          "properties": {
            "targets": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "builtin",
                  "helper",
                  "part"
                ],
                "description": "Call target categories accepting named arguments."
              },
              "description": "Call target categories accepting named arguments.",
              "uniqueItems": true,
              "minItems": 1
            },
            "mixed_positional_and_named": {
              "type": "boolean",
              "description": "Whether one call can mix both argument forms."
            },
            "positional_binding": {
              "type": "string",
              "enum": [
                "positional_parameter_ordinal"
              ],
              "description": "How positional arguments map to declaration slots."
            },
            "named_arguments_advance_positional_ordinal": {
              "type": "boolean",
              "description": "Whether named arguments consume the next positional index."
            },
            "duplicate_arguments": {
              "type": "boolean",
              "description": "Whether a slot can be bound more than once."
            },
            "unknown_arguments": {
              "type": "boolean",
              "description": "Whether a call can include an unknown named slot."
            }
          },
          "required": [
            "targets",
            "mixed_positional_and_named",
            "positional_binding",
            "named_arguments_advance_positional_ordinal",
            "duplicate_arguments",
            "unknown_arguments"
          ],
          "additionalProperties": true,
          "description": "Named and mixed call-binding capabilities."
        },
        "restrictions": {
          "type": "object",
          "properties": {
            "recursive_helpers": {
              "type": "boolean",
              "description": "Whether direct or mutual recursion is accepted."
            },
            "nested_part_imports": {
              "type": "boolean",
              "description": "Whether imported parts may import further parts."
            },
            "let_declarations": {
              "type": "boolean",
              "description": "Whether explicit let declarations are accepted."
            },
            "fn_declarations": {
              "type": "boolean",
              "description": "Whether fn-prefixed helpers are accepted."
            },
            "named_geometry_constructors": {
              "type": "boolean",
              "description": "Whether geometry constructors accept named fields."
            }
          },
          "required": [
            "recursive_helpers",
            "nested_part_imports",
            "let_declarations",
            "fn_declarations",
            "named_geometry_constructors"
          ],
          "additionalProperties": true,
          "description": "Implemented source syntax and static restrictions."
        },
        "effect_order": {
          "type": "object",
          "properties": {
            "binary_operands": {
              "type": "string",
              "enum": [
                "left_to_right"
              ],
              "description": "Operand evaluation sequence."
            },
            "logical_operators": {
              "type": "string",
              "enum": [
                "short_circuit_left_to_right"
              ],
              "description": "Short-circuit operand sequence."
            },
            "call_arguments": {
              "type": "string",
              "enum": [
                "signature_evaluation_order"
              ],
              "description": "Argument effects follow shared binder signature order."
            },
            "named_arguments_change_evaluation_order": {
              "type": "boolean",
              "description": "Whether written named-argument order changes effect execution."
            },
            "part_parent_rng": {
              "type": "string",
              "enum": [
                "restored_after_child"
              ],
              "description": "Parent RNG restoration after child rendering."
            }
          },
          "required": [
            "binary_operands",
            "logical_operators",
            "call_arguments",
            "named_arguments_change_evaluation_order",
            "part_parent_rng"
          ],
          "additionalProperties": true,
          "description": "Order of argument, operand and child RNG effects."
        },
        "random_range": {
          "type": "object",
          "properties": {
            "operator": {
              "type": "string",
              "const": "to",
              "description": "Infix spelling of the random range."
            },
            "keyword": {
              "type": "string",
              "enum": [
                "contextual"
              ],
              "description": "The spelling stays a valid name; existing locals, helpers and parts named 'to' keep their meaning."
            },
            "precedence": {
              "type": "object",
              "properties": {
                "tighter_than": {
                  "type": "string",
                  "description": "Operator that binds more loosely than the range."
                },
                "looser_than": {
                  "type": "string",
                  "description": "Operator that binds more tightly than the range."
                }
              },
              "required": [
                "tighter_than",
                "looser_than"
              ],
              "additionalProperties": true,
              "description": "Position of the range between the binary operator levels."
            },
            "chaining": {
              "type": "boolean",
              "description": "Whether 'a to b to c' parses; parenthesized ranges may still be bounds."
            },
            "evaluation_order": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "lower",
                  "upper"
                ],
                "description": "Bound evaluated once at this position, before the draw."
              },
              "description": "Bound evaluation sequence; the draw follows both bounds' effects.",
              "minItems": 2
            },
            "overloads": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "lower": {
                    "type": "string",
                    "description": "Lower bound type after widening."
                  },
                  "upper": {
                    "type": "string",
                    "description": "Upper bound type after widening."
                  },
                  "result": {
                    "type": "string",
                    "description": "Value type of the draw."
                  },
                  "opcode": {
                    "type": "string",
                    "description": "Instruction mnemonic of the draw."
                  },
                  "minimum_format_minor": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 255,
                    "description": "Oldest binary format minor containing the instruction."
                  },
                  "bounds": {
                    "type": "string",
                    "enum": [
                      "inclusive"
                    ],
                    "description": "Both bounds are possible results."
                  },
                  "draws": {
                    "type": "object",
                    "properties": {
                      "minimum": {
                        "type": "integer",
                        "minimum": 1,
                        "description": "Fewest stream steps of one evaluation."
                      },
                      "maximum": {
                        "type": "integer",
                        "minimum": 1,
                        "description": "Most stream steps of one evaluation; each step after the first costs 1 fuel."
                      }
                    },
                    "required": [
                      "minimum",
                      "maximum"
                    ],
                    "additionalProperties": true,
                    "description": "Stream steps taken by one evaluation."
                  }
                },
                "required": [
                  "lower",
                  "upper",
                  "result",
                  "opcode",
                  "minimum_format_minor",
                  "bounds",
                  "draws"
                ],
                "additionalProperties": true,
                "description": "One accepted bound type pair and its lowering."
              },
              "description": "Accepted bound type pairs and their lowerings.",
              "minItems": 1
            },
            "mixed_numeric_bounds": {
              "type": "string",
              "enum": [
                "widen_to_f32"
              ],
