          "description": "Conservative isolated child-body effects."
        },
        "seed_read": {
          "$ref": "#/$defs/effects",
          "description": "Reading the seed expression."
        },
        "output_write": {
          "$ref": "#/$defs/effects",
          "description": "Writing a declared output."
        },
        "part_output_read": {
          "$ref": "#/$defs/effects",
          "description": "Reading a singular exported child output."
        },
        "integer_division": {
          "$ref": "#/$defs/effects",
          "description": "Checked signed division."
        },
        "integer_remainder": {
          "$ref": "#/$defs/effects",
          "description": "Checked signed remainder."
        },
        "output_write_policy": {
          "type": "object",
          "properties": {
            "singular": {
              "type": "string",
              "enum": [
                "replace"
              ],
              "description": "Each scalar write replaces the previous value."
            },
            "list": {
              "type": "string",
              "enum": [
                "append"
              ],
              "description": "Each list write appends an element."
            }
          },
          "required": [
            "singular",
            "list"
          ],
          "additionalProperties": true,
          "description": "Output write accumulation policies."
        }
      },
      "required": [
        "intrinsic_scope",
        "argument_effects",
        "resource_traps",
        "validation_limits",
        "allocation_failure",
        "helper",
        "part",
        "seed_read",
        "output_write",
        "part_output_read",
        "integer_division",
        "integer_remainder",
        "output_write_policy"
      ],
      "additionalProperties": true,
      "description": "Resource limits and operation summaries beyond builtin signatures."
    },
    "call_rules": {
      "type": "object",
      "properties": {
        "helper_evaluation_order": {
          "type": "string",
          "enum": [
            "declaration"
          ],
          "description": "Helper arguments evaluate in parameter declaration order."
        },
        "part": {
          "type": "object",
          "properties": {
            "parameters": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/partParameter",
                "description": "Part control or input slot."
              },
              "description": "Part binder parameters."
            },
            "evaluation_order": {
              "type": "array",
              "items": {
                "type": "string",
                "description": "Binder slot name.",
                "minLength": 1
              },
              "description": "Exact parameter permutation; overrides evaluate in caller context.",
              "uniqueItems": true
            }
          },
          "required": [
            "parameters",
            "evaluation_order"
          ],
          "additionalProperties": true,
          "description": "Shared part-call binder contract."
        }
      },
      "required": [
        "helper_evaluation_order",
        "part"
      ],
      "additionalProperties": true,
      "description": "Call metadata shared with the compiler binder."
    },
    "builtins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/builtin",
        "description": "Registered callable."
      },
      "description": "Shared registry exports; order is stable but not an identity key.",
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "product_version",
    "language_version",
    "format_version",
    "c_api_version",
    "abi_version",
    "source_rules",
    "effect_rules",
    "call_rules",
    "builtins"
  ],
  "additionalProperties": true,
  "description": "Compiler language description.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "infinite-props language-description schema 2",
  "$defs": {
    "version": {
      "type": "object",
      "properties": {
        "major": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Major version component."
        },
        "minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Minor version component."
        }
      },
      "required": [
        "major",
        "minor"
      ],
      "additionalProperties": true,
      "description": "An independently versioned major/minor contract."
    },
    "effects": {
      "type": "object",
      "properties": {
        "rng": {
          "type": "string",
          "enum": [
            "advance_current",
            "isolated_callee_stream",
            "isolated_seeded_stream",
            "none",
            "push_seeded_stream",
            "read_current",
            "restore_stream",
            "seeded_computation",
            "shared_callee_stream"
          ],
          "description": "Intrinsic stream interaction; arguments run first in the caller stream."
        },
        "writes_canvas": {
          "type": "boolean",
          "description": "May write pixels to the active canvas."
        },
        "writes_outputs": {
          "type": "boolean",
          "description": "May replace a scalar output or append a list element."
        },
        "summary": {
          "type": "string",
          "enum": [
            "conservative",
            "intrinsic"
          ],
          "description": "Intrinsic operation or conservative callee summary."
        },
        "may_trap": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "callee",
              "divide_by_zero",
              "integer_overflow",
              "numeric_range",
              "part_output_context",
              "part_output_missing",
              "part_render_arguments",
              "stream_stack_underflow"
            ],
            "description": "Call-specific checks; resource-wide traps are separate."
          },
          "description": "Call-specific checks; resource-wide traps are separate.",
          "uniqueItems": true
        }
      },
      "required": [
        "rng",
        "writes_canvas",
        "writes_outputs",
        "summary",
        "may_trap"
      ],
      "additionalProperties": true,
      "description": "Intrinsic effects excluding evaluated arguments and resource limits."
    },
    "parameter": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Canonical binder slot name.",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "T",
            "circle",
            "color",
            "distribution",
            "f32",
            "i32",
            "palette<color>",
            "palette<f32>",
            "rect",
            "vec2",
            "void"
          ],
          "description": "Source value type; T is a variadic choice template."
        }
      },
      "required": [
        "name",
        "type"
      ],
      "additionalProperties": true,
      "description": "A parameter supplied by the shared signature registry."
    },
    "signature": {
      "type": "object",
      "properties": {
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter",
            "description": "Ordered binder parameters."
          },
          "description": "Parameters in binder declaration order."
        },
        "result": {
          "type": "string",
          "enum": [
            "T",
            "circle",
            "color",
            "distribution",
            "f32",
            "i32",
            "palette<color>",
            "palette<f32>",
            "rect",
            "vec2",
            "void"
          ],
          "description": "Return value type; void produces no value."
        },
        "evaluation_order": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Parameter name.",
            "minLength": 1
          },
          "description": "Permutation of parameter names defining effect evaluation order.",
          "uniqueItems": true
        },
        "effects": {
          "$ref": "#/$defs/effects",
          "description": "Intrinsic operation effects."
        },
        "opcode": {
          "type": "string",
          "description": "Lowered opcode registry identifier.",
          "minLength": 1
        },
        "minimum_format_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "Earliest binary-format minor supporting the opcode."
        }
      },
      "required": [
        "parameters",
        "result",
        "evaluation_order",
        "effects"
      ],
      "additionalProperties": true,
      "description": "An overload from the shared signature registry."
    },
    "variadic": {
      "type": "object",
      "properties": {
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter",
            "description": "Ordered binder parameters."
          },
          "description": "Parameters in binder declaration order."
        },
        "result": {
          "type": "string",
          "enum": [
            "T",
            "circle",
            "color",
            "distribution",
            "f32",
            "i32",
            "palette<color>",
            "palette<f32>",
            "rect",
            "vec2",
            "void"
          ],
          "description": "Return value type; void produces no value."
        },
        "evaluation_order": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Parameter name.",
            "minLength": 1
          },
          "description": "Permutation of parameter names defining effect evaluation order.",
          "uniqueItems": true
        },
        "effects": {
          "$ref": "#/$defs/effects",
          "description": "Intrinsic operation effects."
        },
        "minimum_arguments": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "Minimum accepted argument count."
        },
        "repeat": {
          "type": "string",
          "enum": [
            "choices",
            "coordinate_pairs"
          ],
          "description": "How the template repeats for further arguments."
        },
        "choice_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "T",
              "circle",
              "color",
              "distribution",
              "f32",
              "i32",
              "palette<color>",
              "palette<f32>",
              "rect",
              "vec2",
              "void"
            ],
            "description": "Allowed value types for every eager choice."
          },
          "description": "Allowed value types for every eager choice.",
          "uniqueItems": true,
          "minItems": 1
        },
        "choice_evaluation": {
          "type": "string",
          "enum": [
            "eager_once_before_selection_rng"
          ],
          "description": "All choices evaluate once before selection consumes RNG."
        }
      },
      "required": [
        "parameters",
        "result",
        "evaluation_order",
        "effects",
        "minimum_arguments",
        "repeat"
      ],
      "additionalProperties": true,
      "description": "Variadic template from the shared binder registry.",
      "allOf": [
        {
          "if": {
            "properties": {
              "repeat": {
                "const": "choices"
              }
            }
          },
          "then": {
            "required": [
              "choice_types",
              "choice_evaluation"
            ]
          }
        }
      ]
    },
    "partParameter": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Part-call binder slot; $uniform stands for each declared input.",
          "minLength": 1
        },
        "required": {
          "type": "boolean",
          "description": "Slot has no implicit default."
        },
        "positional": {
          "type": "boolean",
          "description": "Slot accepts positional binding."
        },
        "default": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Integer default."
            },
            {
              "const": "input_declaration"
            }
          ],
          "description": "Optional slot default, including the imported input declaration."
        }
      },
      "required": [
        "name",
        "required",
        "positional"
      ],
      "additionalProperties": true,
      "description": "A part-call control or imported uniform slot.",
      "allOf": [
        {
          "if": {
            "properties": {
              "required": {
                "const": true
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "default"
              ]
            }
          },
          "else": {
            "required": [
              "default"
            ]
          }
        }
      ]
    },
    "builtin": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Registered builtin identifier.",
          "minLength": 1
        },
        "overloads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/signature",
            "description": "One registered overload."
          },
          "description": "All fixed arities."
        },
        "variadic": {
          "$ref": "#/$defs/variadic",
          "description": "Optional variadic binder template."
        }
      },
      "required": [
        "name",
        "overloads"
      ],
      "additionalProperties": true,
      "description": "A registered builtin.",
      "anyOf": [
        {
          "properties": {
            "overloads": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "variadic"
          ]
        }
      ]
    }
  }
}
