            },
            "traps": {
              "type": "array",
              "items": {
                "type": "string",
                "description": "Runtime numeric-range condition checked before the draw."
              },
              "description": "Runtime numeric-range conditions checked before the draw.",
              "uniqueItems": true
            },
            "equal_bounds": {
              "type": "string",
              "enum": [
                "bound_after_one_draw"
              ],
