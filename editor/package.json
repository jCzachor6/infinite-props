{
  "name": "iprop-studio",
  "displayName": "iprop studio",
  "description": "The .ips authoring tools: syntax highlighting and inline diagnostics from the compiler. Edit files, run CLI agents in the integrated terminal.",
  "version": "0.7.2",
  "publisher": "iprop",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:ips"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ips",
        "extensions": [
          ".ips"
        ],
        "aliases": [
          "iprop Source",
          "ips"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ips",
        "scopeName": "source.ips",
        "path": "./syntaxes/ips.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "iprop.compile",
        "title": "iprop: Compile"
      },
      {
        "command": "iprop.preview",
        "title": "iprop: Open Preview"
      },
      {
        "command": "iprop.reloadPreview",
        "title": "iprop: Reload Preview"
      },
      {
        "command": "iprop.atlas",
        "title": "iprop: Open Atlas"
      },
      {
        "command": "iprop.inspector",
        "title": "iprop: Open Bytecode Inspector"
      },
      {
        "command": "iprop.exportBinary",
        "title": "iprop: Export .iprop"
      },
      {
        "command": "iprop.exportPng",
        "title": "iprop: Export PNG"
      },
      {
        "command": "iprop.exportSheet",
        "title": "iprop: Export Seed Sheet"
      },
      {
        "command": "iprop.openImport",
        "title": "iprop: Open Import\u2026"
      }
    ],
    "configuration": {
      "title": "iprop",
      "properties": {
        "iprop.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the ipc compiler binary. Defaults to <workspace>/build/tools/ipc."
        },
        "iprop.rendererPath": {
          "type": "string",
          "default": "",
          "description": "Path to the ipgen renderer binary. Defaults to <workspace>/build/tools/ipgen."
        },
        "iprop.disassemblerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the ipdis disassembler binary. Defaults to <workspace>/build/tools/ipdis."
        },
        "iprop.validatorPath": {
          "type": "string",
          "default": "",
          "description": "Path to the ipval binary. Defaults to <workspace>/build/tools/ipval."
        },
        "iprop.sheetPath": {
          "type": "string",
          "default": "",
          "description": "Path to the ipsheet binary. Defaults to <workspace>/build/tools/ipsheet."
        }
      }
    },
    "keybindings": [
      {
        "command": "iprop.preview",
        "key": "alt+p",
        "when": "editorLangId == ips"
      },
      {
        "command": "iprop.atlas",
        "key": "alt+a",
        "when": "editorLangId == ips"
      },
      {
        "command": "iprop.inspector",
        "key": "alt+i",
        "when": "editorLangId == ips"
      },
      {
        "command": "iprop.exportBinary",
        "key": "alt+e",
        "when": "editorLangId == ips"
      },
      {
        "command": "iprop.exportSheet",
        "key": "alt+shift+e",
        "when": "editorLangId == ips"
      }
    ]
  }
}
