{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ips",
  "scopeName": "source.ips",
  "patterns": [
    {
      "include": "#maskType"
    },
    {
      "include": "#clipScope"
    },
    {
      "include": "#layerCapture"
    },
    {
      "include": "#surfaceMode"
    },
    {
      "include": "#pointDistribution"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#colors"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#assetConstant"
    },
    {
      "include": "#modelKeywords"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#rangeOperator"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#modelTypes"
    },
    {
      "include": "#seedType"
    },
    {
      "include": "#types"
    },
    {
      "include": "#samplerCapture"
    },
    {
      "include": "#samplerMethod"
    },
    {
      "include": "#listMethod"
    },
    {
      "include": "#surfaceMethod"
    },
    {
      "include": "#seedMethod"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "assetConstant": {
      "comment": "Reserved asset constant introducer.",
      "name": "storage.modifier.const.ips",
      "match": "\\bconst\\b"
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ips",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ips",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.ips",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.ips",
          "match": "\\\\."
        }
      ]
    },
    "colors": {
      "name": "constant.other.color.ips",
      "match": "#([0-9a-fA-F]{8}|[0-9a-fA-F]{6}|[0-9a-fA-F]{4}|[0-9a-fA-F]{3})\\b"
    },
    "numbers": {
      "name": "constant.numeric.ips",
      "match": "\\b(0[xX][0-9a-fA-F]+|\\d+(\\.\\d+)?([eE][+-]?\\d+)?)\\b"
    },
    "keywords": {
      "name": "keyword.control.ips",
      "match": "\\b(asset|material|input|output|import|from|draw|at|if|else|while|for|in|break|continue|return|true|false|palette|size|origin)\\b"
    },
    "rangeOperator": {
      "comment": "Reserved range and distribution operators.",
      "name": "keyword.operator.word.range.ips",
      "match": "\\b(to|with)\\b"
    },
    "types": {
      "name": "storage.type.ips",
      "match": "\\b(distribution|sampler|stepper)\\b|\\blist\\b(?=\\s*<)|\\b(diagram2d|contours2d|regions2d|part2d|parts2d|color|f32|u32|i32|vec2|vec3|point|rect|circle)\\b(?!\\s*=(?!=))"
    },
    "operators": {
      "name": "keyword.operator.ips",
      "match": "\\.\\.|->|==|!=|<=|>=|&&|\\|\\||<<|>>|[+\\-*/%^&|~!<>=]"
    },
    "builtins": {
      "name": "support.function.builtin.ips",
      "match": "(?<![.\\w])((?:cell|color|diagram|dist|list|mask|noise|part|parts|regions|skin|stream|surface|vec2|vec3)\\.[A-Za-z_][A-Za-z_0-9]*|seed\\.initial|abs|atan2|band|beta|box|ceil|chance|choose|clamp|cone|contour|cos|curve|cylinder|dither|exp|extrude|float|floor|gain|gaussian|hash|index|int|lathe|lerp|line|max|min|oval|pick|pixel|poly|pow|quad|quintic|ramp|range|rect|regions|remap|rgb|rgba|roll|round|sin|smooth|smoothstep|sphere|sqrt|tri|triangular|unit|voronoi|weather)\\b(?=\\s*\\()",
      "comment": "Builtins of both kinds of asset; the primitives and the skin and vec3 namespaces belong to assets with render."
    },
    "samplerCapture": {
      "name": "support.function.sampler.ips",
      "match": "\\b(?:sampler|stepper)\\b"
    },
    "samplerMethod": {
      "name": "support.function.sampler.pick.ips",
      "match": "(?<=\\.)pick\\b(?=\\s*\\()"
    },
    "listMethod": {
      "name": "support.function.list.ips",
      "match": "(?<=\\.)(distinct|sort)\\b(?=\\s*\\()"
    },
    "surfaceMethod": {
      "name": "support.function.surface.ips",
      "match": "(?<=\\.)(blur|normal)\\b(?=\\s*\\()"
    },
    "pointDistribution": {
      "name": "support.function.distribution.ips",
      "match": "\\b(weighted|density)\\b"
    },
    "layerCapture": {
      "comment": "Reserved layer capture and value type.",
      "name": "keyword.control.layer.ips",
      "match": "\\blayer\\b"
    },
    "surfaceMode": {
      "name": "constant.language.surface-mode.ips",
      "match": "\\bsurface\\.(legacy|source_over|normal)\\b"
    },
    "maskType": {
      "comment": "Reserved mask type and namespace.",
      "name": "storage.type.mask.ips",
      "match": "\\bmask\\b(?!\\s*\\.)"
    },
    "clipScope": {
      "comment": "Reserved clip scope.",
      "name": "keyword.control.clip.ips",
      "match": "\\bclip\\b"
    },
    "seedMethod": {
      "name": "support.function.seed.ips",
      "match": "(?<=\\.)fork\\b(?=\\s*\\()"
    },
    "seedType": {
      "comment": "`seed` names a type only after ':' or '->'; elsewhere it reads the stream state.",
      "match": "(?:(?<=:)|(?<=->))\\s*(seed)\\b",
      "captures": {
        "1": {
          "name": "storage.type.ips"
        }
      }
    },
    "modelTypes": {
      "comment": "`skin` names a type only after ':' or '->' and before a typed local; elsewhere it is an ordinary name.",
      "patterns": [
        {
          "match": "(?:(?<=:)|(?<=->))\\s*(skin)\\b",
          "captures": {
            "1": {
              "name": "storage.type.ips"
            }
          }
        },
        {
          "match": "\\b(skin)\\b(?=\\s+[A-Za-z_][A-Za-z_0-9]*\\s*=(?!=))",
          "captures": {
            "1": {
              "name": "storage.type.ips"
            }
          }
        }
      ]
    },
    "modelKeywords": {
      "comment": "`render` before a block, `scale` before a number and `place` as a call; ordinary names elsewhere.",
      "name": "keyword.control.model.ips",
      "match": "\\brender\\b(?=\\s*\\{)|\\bscale\\b(?=\\s+[0-9])|\\bplace\\b(?=\\s*\\()"
    }
  }
}
