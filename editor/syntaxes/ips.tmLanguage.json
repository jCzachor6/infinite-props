{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ips",
  "scopeName": "source.ips",
  "patterns": [
    {
      "include": "#pointDistribution"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#colors"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#assetConstant"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#rangeOperator"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#types"
    },
    {
      "include": "#samplerCapture"
    },
    {
      "include": "#samplerMethod"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "assetConstant": {
      "comment": "Contextual: only the declaration introducer before an explicit value type.",
      "name": "storage.modifier.const.ips",
      "match": "\\bconst\\b(?=\\s+((i32|f32|color|vec2|distribution)\\b|list\\s*<))"
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ips",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ips",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.ips",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.ips",
          "match": "\\\\."
        }
      ]
    },
    "colors": {
      "name": "constant.other.color.ips",
      "match": "#([0-9a-fA-F]{8}|[0-9a-fA-F]{6}|[0-9a-fA-F]{4}|[0-9a-fA-F]{3})\\b"
    },
    "numbers": {
      "name": "constant.numeric.ips",
      "match": "\\b(0[xX][0-9a-fA-F]+|\\d+(\\.\\d+)?([eE][+-]?\\d+)?)\\b"
    },
    "keywords": {
      "name": "keyword.control.ips",
      "match": "\\b(asset|input|output|import|from|draw|at|if|else|while|for|in|break|continue|return|true|false|palette|size|origin|variants|archetypes)\\b"
    },
    "rangeOperator": {
      "comment": "Contextual: 'to' stays a name before '=', '.' or '('.",
      "name": "keyword.operator.word.range.ips",
      "match": "\\b(to|with)\\b(?!\\s*(=(?!=)|\\.|\\())"
    },
    "types": {
      "name": "storage.type.ips",
      "match": "\\b(list|sampler)\\b(?=\\s*<)|\\b(color|f32|u32|i32|vec2|point|rect|circle|distribution)\\b(?!\\s*=(?!=))"
    },
    "operators": {
      "name": "keyword.operator.ips",
      "match": "\\.\\.|->|==|!=|<=|>=|&&|\\|\\||<<|>>|[+\\-*/%^&|~!<>=]"
    },
    "builtins": {
      "name": "support.function.builtin.ips",
      "match": "\\b(list\\.len|vec2\\.(len|dot|rot|normalize)|unit|stream_push|stream_pop|range|index|pick|chance|roll|choose|hash|noise|fault|smooth|sqrt|sin|cos|abs|floor|ceil|min|max|pow|exp|atan2|i32trunc|int|float|rgb|rgba|round|lerp|gaussian|triangular|beta|color\\.(mix|shade|mul|scale|hsv|set\\.a)|pixel|rect|line|oval|weather|poly)\\b(?=\\s*\\()"
    },
    "samplerCapture": {
      "name": "support.function.sampler.ips",
      "match": "\\bsampler\\b(?=\\s*\\()"
    },
    "samplerMethod": {
      "name": "support.function.sampler.pick.ips",
      "match": "(?<=\\.)pick\\b(?=\\s*\\()"
    },
    "pointDistribution": {
      "name": "support.function.distribution.ips",
      "match": "\\bweighted\\b(?=\\s*\\{)"
    }
  }
}
