// plant.ips — the QuantSpace interior potted plant (PaPlant), composed
// from the pot and flower parts. The identity draws, the two interleaved
// RNG streams (the main seed stream and the derived detail stream
// hash(seed ^ 0x6b1d4f27)) and the paint order match the reference: the
// foliage is painted first, then the pot, whose front face covers the stem
// bases — call order is paint order.

import pot from "pot.ips"
import flower from "flower.ips"

asset plant {
  size 64x64
  origin 32,56

  palette darkLeaves = [#365c38, #4c603e, #264a46, #704430, #54625c]
  palette midLeaves = [#4e7c4a, #687e56, #3a645c, #945a3a, #728076]
  palette lightLeaves = [#6c9a62, #8a986c, #588476, #bc7e4c, #96a092]
  palette pots = [#967864, #7e7462, #6a7074, #beb6a2]
  palette blooms = [#e89648, #e2d6be, #c4788c]

  draw(v: i32, a: i32) {
    // ===== identity: the main seed stream =====
    leavesIndex = index(5)
    potIndex = index(8)

    // ===== the derived detail stream =====
    stream_push(hash(seed ^ 0x6b1d4f27))
    potShade = index(9) - 4
    tag = unit() < 0.35
    drops = unit() < 0.45
    dSaved = seed
    stream_pop()

    // ===== main stream: the shape =====
    species = index(6)
    style = index(6)
    widthN = index(6)
    rimDepth = 2.2 + index(3)
    heightN = index(15)
    height = 15.0 + heightN
    leafDark = darkLeaves[leavesIndex]
    leafMid = midLeaves[leavesIndex]
    leafLight = lightLeaves[leavesIndex]
    potColor = shade(pots[potIndex], potShade)
    bloomColor = blooms[index(3)]

    // ===== paint order: foliage first, then the pot (its front face
    //      covers the stem bases) =====
    flower.draw(seed, v, a, at = {0, 0}, species = species, height = height,
                heightN = heightN, leafDark = leafDark, leafMid = leafMid,
                leafLight = leafLight, bloom = bloomColor,
                detailState = dSaved)
    pot.draw(hash(seed ^ 0x7c1a9e4d), v, a, at = {0, 0}, color = potColor,
             style = style, widthN = widthN, rimDepth = rimDepth,
             tag = tag, drops = drops, crumbColor = leafDark)
  }
}
