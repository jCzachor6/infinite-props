// Every primitive, placement argument, skin modifier and vec3 operation of
// models v1.2, with sizes and angles that vary with the seed: the native and
// the WASM runtime must agree on every bit of the result.
import panel from "model-skin.ips"

asset primitives {
  size 120x24x64
  scale 64

  input f32 stretch = 1.0
  input color tint = #7d8791
  input u32 sides = 12
  input f32 rounding = 0.6

  const vec3 lean = vec3.normalize({1, 2, 0.5})

  render {
    root = seed.initial()
    plain = panel.draw(root.fork("plain"), tint = tint, rounding = rounding)
    fixed = panel.draw(77, tint = tint, rounding = rounding, size = {48, 32})
    dense = skin.shift(skin.density(plain, 2.5), {3.5, -1.25})
    fitted = skin.fit(fixed)
    shiny = skin.metallic(skin.roughness(plain, 0.2), 0.9)
    glow = skin.crisp(skin.emission(fixed, 1.75))
    leaf = skin.two_sided(skin.cutout(fitted, 0.35))

    a = 3.0 to 7.0
    b = 2.0 to 5.0
    turn = 10.0 to 80.0

    // Unplaced, in the root scope: the middle row.
    box({-54, 0, 0}, {a * stretch, b, a}, plain)
    box({-42, 0, 0}, {a, b, a * stretch}, 0.4, dense)
    cylinder({-30, 0, 0}, b * 0.5, a, int(sides), shiny)
    cone({-18, 0, 0}, b * 0.6, b * 0.25, a, int(sides), plain)
    cone({-18, a, 0}, b * 0.25, 0.0, b, 5, glow)
    band({-6, 0, 0}, b * 0.5, b * 0.7, a, int(sides), leaf)
    sphere({6, b, 0}, b * 0.8, int(sides), 6, dense)
    lathe({18, 0, 0}, [{0, 0}, {b * 0.6, 0}, {b * 0.8, a * 0.3}, {b * 0.3, a * 0.5}, {b * 0.5, a}, {0, a}], int(sides), plain)
    lathe({30, 0, 0}, [{b * 0.5, 0}, {b * 0.7, a * 0.4}, {b * 0.6, a * 0.8}, {b * 0.2, a}], int(sides), 50.0, shiny)
    extrude({42, 0, 0}, [{0, 0}, {a, 0}, {a, b * 0.4}, {a * 0.4, b * 0.4}, {a * 0.4, b}, {0, b}], 2.0, plain)
    extrude({54, 0, 0}, [{0, 0}, {a, 0}, {a * 0.5, b}], 3.0, 0.3, dense)

    // The front row: flat pieces and a point every vec3 operation had a hand in.
    quad({-54, 0, 20}, {a - 54.0, 0, 20}, {a - 54.0, b, 21}, {-54, b, 21}, leaf)
    tri({-42, 0, 20}, {a - 42.0, 0, 20}, {-42, b, 22}, glow)
    u = vec3.normalize(vec3.cross(lean, {0, 0, 1}))
    v = lerp(lean * a, u * b, 0.3) - {0, 1, 0} / b + -u * {1, 2, 3}
    w = (lean to u * a) + {vec3.len(v), vec3.dot(u, lean), v.x + v.y + v.z} * 0.125
    tri(v + {-30, 4, 20}, w + {-26, 4, 20}, u * 3.0 + {-30, 9, 20}, plain)

    // The back row, placed: every argument alone and combined, nested and mirrored.
    place(at = {-54, 0, -20}, yaw = turn) { box({0, 0, 0}, {a, b, 2}, 0.3, plain) }
    place(at = {-42, 0, -20}, pitch = -turn * 0.5) { cylinder({0, 0, 0}, 1.5, a, int(sides), dense) }
    place(at = {-30, 0, -20}, roll = turn + 90.0) { cone({0, 0, 0}, 2.0, 1.0, a, 7, shiny) }
    place(at = {-18, 0, -20}, yaw = 90.0, pitch = 180.0, roll = -270.0) { box({0, 0, 0}, {a, b, 3}, plain) }
    place(at = {-6, 0, -20}, scale = 0.5 + stretch) { sphere({0, 2, 0}, 2.0, 9, 5, fitted) }
    place(at = {6, 0, -20}, scale = {1.0, stretch + 0.5, 0.25 * a}) { box({0, 0, 0}, {3, 3, 3}, 0.5, dense) }
    place(at = {18, 0, -20}, mirror_x = 1) { extrude({0, 0, 0}, [{0, 0}, {a, 0}, {a * 0.3, b}], 2.0, 0.2, plain) }
    place(at = {30, 0, -20}, mirror_y = 1, mirror_z = 1) { lathe({0, -a, 0}, [{1, 0}, {2, a * 0.5}, {1, a}], 8, 60.0, shiny) }
    place(at = {44, 0, -20}, yaw = turn, mirror_x = 1, mirror_y = 1, mirror_z = 1) {
      place(at = lean * a, pitch = 37.5, scale = 1.25) {
        place(roll = -turn, mirror_x = 1) { box({0, 0, 0}, {a, b, 2}, 0.25, glow) }
        band({0, 0, 0}, 3.0, 2.0, 2.0, 6, leaf)
      }
    }
  }
}
