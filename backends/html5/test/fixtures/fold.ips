asset foldProbe {
  size 8x8
  output point positive_nan
  output point negative_nan
  output point nan_y
  output point both_nan
  output point infinite_radius
  output point finite_radius_overflow
  output point diagonal_infinities
  output point identity
  output point zero

  draw(v: i32, a: i32) {
    nan = pow(-2, 0.5)
    inf = exp(100)
    positive_nan = fold({nan, 1.0}, 4)
    negative_nan = fold({-nan, 1.0}, 4)
    nan_y = fold({1.0, -nan}, 4)
    both_nan = fold({nan, -nan}, 4)
    infinite_radius = fold({inf, 0.0}, 4)
    finite_radius_overflow = fold({100000000000000000000.0, 0.0}, 4)
    diagonal_infinities = fold({inf, inf}, 4)
    identity = fold({1.0, 0.0}, 4)
    zero = fold({0.0, 0.0}, 4)
  }
}
