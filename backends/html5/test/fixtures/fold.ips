asset foldProbe {
  size 8x8
  output point positive_nan
  output point negative_nan
  output point nan_y
  output point both_nan
  output point infinite_radius
  output point finite_radius_overflow
  output point diagonal_infinities
  output point identity
  output point zero

  draw {
    nan = pow(-2, 0.5)
    inf = exp(100)
    positive_nan = vec2.fold({nan, 1.0}, 4)
    negative_nan = vec2.fold({-nan, 1.0}, 4)
    nan_y = vec2.fold({1.0, -nan}, 4)
    both_nan = vec2.fold({nan, -nan}, 4)
    infinite_radius = vec2.fold({inf, 0.0}, 4)
    finite_radius_overflow = vec2.fold({100000000000000000000.0, 0.0}, 4)
    diagonal_infinities = vec2.fold({inf, inf}, 4)
    identity = vec2.fold({1.0, 0.0}, 4)
    zero = vec2.fold({0.0, 0.0}, 4)
  }
}
