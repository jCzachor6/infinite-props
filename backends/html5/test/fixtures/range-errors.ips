asset rangeErrors { input i32 v = 0
  size 1x1
  output point p
  draw {
    zero = 0.0
    if (v == 0) {
      p = {v + 1 to 0, 0}
    } else if (v == 1) {
      p = {zero / zero to 1.0, 0}
    } else if (v == 2) {
      p = {0.0 to 1.0 / zero, 0}
    } else {
      p = {2.0 to 1.5, 0}
    }
  }
}
