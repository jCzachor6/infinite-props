import tile from "transform-tile.ips"
asset partTransforms { input i32 a = 0 input i32 v = 0
  size 12x8
  output point p
  output rect r
  output circle c

  draw {
    if (v == 0) {
      tile.draw(seed, at = {4, 1})
    } else if (v == 1) {
      tile.draw(seed, at = {4, 1}, rot = 90)
    } else if (v == 2) {
      tile.draw(seed, at = {4, 1}, rot = 180)
    } else if (v == 3) {
      tile.draw(seed, at = {4, 1}, rot = 270)
    } else if (v == 4) {
      tile.draw(seed, at = {4, 1}, mirror_x = true)
    } else if (v == 5) {
      tile.draw(seed, at = {4, 1}, mirror_y = true)
    } else if (v == 6) {
      tile.draw(seed, at = {4, 1}, rot = 90, mirror_y = true)
    } else {
      tile.draw(seed, at = {4, 1}, rot = 90, mirror_x = true)
    }
    p = tile.outputs.anchor
    r = tile.outputs.box
    c = tile.outputs.zone
  }
}
