asset colorErrors {
  size 8x8
  variants 4
  draw(v: i32, a: i32) {
    if (v == 0) {
      pixel(0, 0, color.hsv(#ff8000, exp(100), 1, 1))
    } else if (v == 1) {
      pixel(0, 0, color.hsv(#ff8000, -exp(100), 1, 1))
    } else if (v == 2) {
      pixel(0, 0, color.hsv(#ff8000, sqrt(-1), 1, 1))
    } else {
      pixel(0, 0, color.hsv(#ff8000, -sqrt(-1), 1, 1))
    }
  }
}
