import mat from "material-library.ips"
asset Materials {
  size 8x2
  output point observed
  draw {
    m__width = 17
    m = mat.Coat(base = #00ff00)
    copy = m
    m = mat.Coat(base = #ff0000, width = m.base.r, offset = {m.offset.y, m.offset.x})
    observed = {float(m.width), m.offset.x}
    pixel(0, 0, copy.base)
    pixel(1, 0, rgba(m__width, m.width, 0, 255))
    for i in 2..6 {
      m = mat.Coat(base = rgba(m.base.r - 1, 0, 0, 255), width = m.base.r)
      pixel(i, 0, rgba(m.width, 0, 0, 255))
    }
    sampled = mat.Coat()
    pixel(6, 0, sampled.shade)
    pixel(7, 0, #000000 to #ffffff)
    n = mat.paint()
    paint(n)
  }
  paint(m: mat.paint) { pixel(0, 1, m.base) }
  gaussian(mean: f32, sigma: f32) -> f32 { return mean + sigma }
}
