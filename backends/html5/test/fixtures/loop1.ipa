; Regression fixture from BUG-REPORT-wasm-divergence.md. The third pixel
; is #598190ff on both backends; the old PNG harness decoded it incorrectly.
meta: size=64x64 fuel=1000000
fn draw (  ) -> ( ):
  locals: i32 f32
  const.i32 0
  local.set 0
  loop
    local.get 0
    const.i32 0
    local.get 0
    i32.to.f32
    const.f32 8.0
    f32.div
    const.f32 0.0
    const.i32 7
    noise
    local.set 1
    const.color #1a2733ff
    const.color #7fb8c8ff
    local.get 1
    color.mix
    pixel
    local.get 0
    const.i32 1
    i32.add
    local.set 0
    local.get 0
    const.i32 3
    i32.lt_s
    br_if 0
  end
  return
endfn
