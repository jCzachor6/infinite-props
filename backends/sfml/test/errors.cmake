function(expect_error)
    execute_process(COMMAND "${HOST}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT result MATCHES "^[12]$")
        message(FATAL_ERROR "Uncontrolled CLI failure (${result}): ${ARGN}\n${stderr}")
    endif()
    if(stderr STREQUAL "")
        message(FATAL_ERROR "Missing CLI diagnostic: ${ARGN}")
    endif()
endfunction()

expect_error("${PROGRAM}.missing" --export "${OUTPUT}")
expect_error("${PROGRAM}" --variant 99 --export "${OUTPUT}")
foreach(token abc 1tail -1 4294967296 18446744073709551616)
    expect_error("${PROGRAM}" --seed "${token}" --export "${OUTPUT}")
    expect_error("${PROGRAM}" --variant "${token}" --export "${OUTPUT}")
endforeach()
expect_error("${PROGRAM}" --seed)
expect_error("${PROGRAM}" --unknown)
file(WRITE "${OUTPUT}.invalid" "not an iprop")
expect_error("${OUTPUT}.invalid" --export "${OUTPUT}")
file(REMOVE "${OUTPUT}.invalid")
execute_process(COMMAND "${HOST}" "${PROGRAM}" --seed 4294967295 --export "${OUTPUT}"
    RESULT_VARIABLE result ERROR_VARIABLE stderr)
if(NOT result STREQUAL "0")
    message(FATAL_ERROR "Valid maximum u32 failed: ${stderr}")
endif()
file(REMOVE "${OUTPUT}")
