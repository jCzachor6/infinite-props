import first from "reflection-output-first.ips"
import empty from "reflection-output-empty.ips"
import second from "reflection-output-second.ips"
asset values { input i32 v = 0
  size 32x32
  output point anchor
  output rect collider
  output circle zone
  output list point anchors
  output list rect colliders
  output list circle zones
  emit(x: f32, y: f32) {
    anchors = {x, y}
    colliders = {x, y, 3, 4}
    zones = {x, y, 5}
  }
  draw {
    if (v != 0) { anchor = {1, 2} anchor = {5, 6} }
    collider = {1, 2, 3, 4}
    collider = {4, 5, 6, 7}
    zone = {8, 9, 10}
    emit(y = 2.0, x = 1.0)
    emit(x = 11.0, y = 12.0)
    if (v == 0) { first.draw(seed, at = {3, 4}) }
    if (v == 1) { first.draw(seed, at = {3, 4}, rot = 90) }
    if (v == 2) { first.draw(seed, at = {3, 4}, rot = 180) }
    if (v == 3) { first.draw(seed, at = {3, 4}, rot = 270) }
    if (v == 4) { first.draw(seed, at = {3, 4}, mirror_x = true) }
    if (v == 5) { first.draw(seed, at = {3, 4}, rot = 90, mirror_x = true) }
    if (v == 6) { first.draw(seed, at = {3, 4}, rot = 180, mirror_x = true) }
    if (v == 7) { first.draw(seed, at = {3, 4}, rot = 270, mirror_x = true) }
    empty.draw(seed, at = {0, 0})
    second.draw(seed, at = {0, 0})
  }
}
