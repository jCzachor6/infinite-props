; Valid control-flow fixture. The C test replaces the scalar before `if`
; with an i32 constant to reproduce review R1 at the public load boundary.
meta: size=1x1 origin=0,0 variants=1 archetypes=1 fuel=1000
fn draw ( i32, i32 ) -> ( ):
  const.f32 1
  const.f32 2
  vec2.make
  const.f32 1
  const.i32 0
  if
    drop
    const.f32 1
  end
  vec2.mul
  drop
  return
endfn
