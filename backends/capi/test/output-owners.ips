import first from "owner-first.ips"
import second from "owner-second.ips"
asset outputs {
  size 8x8
  output point anchor
  output rect collider
  output circle zone
  draw {
    anchor = {4, 0}
    collider = {4, 0, 1, 1}
    zone = {4, 0, 1}
    first.draw(seed, at = {0, 0})
    second.draw(seed, at = {0, 0})
  }
}
