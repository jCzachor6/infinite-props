; Noise-field corpus entry: a per-pixel value-noise gradient.
meta: size=64x64 fuel=2000000
fn draw (  ) -> ( ):
  locals: i32 i32 f32
  const.i32 0
  local.set 1
  loop
    const.i32 0
    local.set 0
    loop
      local.get 0
      local.get 1
      local.get 0
      i32.to.f32
      const.f32 8.0
      f32.div
      local.get 1
      i32.to.f32
      const.f32 8.0
      f32.div
      const.i32 7
      noise
      local.set 2
      const.color #1a2733ff
      const.color #7fb8c8ff
      local.get 2
      color.mix
      pixel
      local.get 0
      const.i32 1
      i32.add
      local.set 0
      local.get 0
      const.i32 64
      i32.lt_s
      br_if 0
    end
    local.get 1
    const.i32 1
    i32.add
    local.set 1
    local.get 1
    const.i32 64
    i32.lt_s
    br_if 0
  end
  return
endfn
