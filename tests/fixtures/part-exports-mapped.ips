import source from "part-exports-raster-source.ips"

asset MappedRasterOutputs {
  size 20x18
  output list part pieces
  draw {
    source.draw(7, at={-3.5, 4.25}, rot=90, mirror_x=1, mirror_y=0)
    image = source.outputs.image
    shape = source.outputs.shape
    p = part.create(image)
    pieces = p
    pieces = part.texture(p, image)
    pieces = part.create(shape)
    layer empty {}
    pieces = part.create(mask.union(shape, mask.from(empty)))
    pieces = part.place(p, {-1.5, -0.5}, 0, 1, 1)
  }
}
