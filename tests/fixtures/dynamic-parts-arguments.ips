asset argument_order {
    size 8x8
    output list point calls
    output list point metrics
    mr(tag: i32, value: regions2d) -> regions2d { calls = {tag, unit()} return value }
    mm(tag: i32, value: mask) -> mask { calls = {tag, unit()} return value }
    ml(tag: i32, value: layer) -> layer { calls = {tag, unit()} return value }
    mp(tag: i32, value: part2d) -> part2d { calls = {tag, unit()} return value }
    ms(tag: i32, value: parts2d) -> parts2d { calls = {tag, unit()} return value }
    mi(tag: i32, value: i32) -> i32 { calls = {tag, unit()} return value }
    mv(tag: i32, value: vec2) -> vec2 { calls = {tag, unit()} return value }
    mc(tag: i32, value: color) -> color { calls = {tag, unit()} return value }
    draw {
        rs = regions(voronoi({0, 0}, {8, 8}, 1, 11))
        layer image(alpha=surface.source_over) { rect(0, 0, 8, 8, #ffffff80) }
        mask shape = mask.from(image)
        p = part.create(index=mi(2, 0), source=mr(1, rs))
        a = part.create(mm(3, shape))
        b = part.create(ml(4, image))
        ps = parts.from_regions(mr(5, rs))
        n = parts.count(ms(6, ps))
        original = parts.get(index=mi(8, 0), source=ms(7, ps))
        q = part.place(mirror_y=mi(13, 0), mirror_x=mi(12, 1), rot=mi(11, 90),
                       at=mv(10, {3.25, -0.5}), p=mp(9, p))
        q = part.fill(tint=mc(15, #11223380), p=mp(14, q))
        q = part.texture(image=ml(17, image), p=mp(16, q))
        part.draw(mp(18, q))
        mask transformed = part.mask(mp(19, q))
        metrics = {part.id(mp(20, q)), part.source_id(mp(21, q))}
        metrics = part.center(mp(22, q))
        metrics = part.bounds_origin(mp(23, q))
        metrics = part.bounds_size(mp(24, q))
        metrics = {part.id(p), part.id(a)}
        metrics = {part.id(b), part.id(original)}
        metrics = {n, part.id(part.create(rs, 0))}
    }
}
