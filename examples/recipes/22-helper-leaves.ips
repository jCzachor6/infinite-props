// A reusable typed drawing helper.
asset HelperLeaves {
  size 32x32

  draw {
    rect(0, 0, 32, 32, #101820)
    for i in 0..4 {
      leaf({8 + i * 5, 8 + i * 5}, choose(hash(seed ^ i), #5a8, #9c8))
    }
  }

  leaf(center: vec2, color: color) {
    oval(center.x, center.y, 3, 5, color)
    line(center.x, center.y - 4, center.x, center.y + 4, 1, color.shade(color, -48))
  }
}
