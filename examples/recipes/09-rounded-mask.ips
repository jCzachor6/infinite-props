// Distance coverage with rounded rectangle geometry.
asset RoundedMask {
  size 32x32

  draw {
    rect(0, 0, 32, 32, #101820)
    for y in 0..32 {
      for x in 0..32 {
        d = dist.roundrect({x, y}, {16, 16}, {10, 8}, 3)
        pixel(x, y, color.set.a(#5bf, int(fill(d, 1) * 255)))
      }
    }
  }
}
