// flower.ips — the foliage part of the QuantSpace interior plant (PaPlant):
// all six species (Broadleaf, Spiky, Succulent, Bushy, Flowering, Arching
// Fronds) in the reference's order. The Succulent's petal ring and the
// Fronds' arcs draw with the pinned sin/cos builtins (spec §12.7).
//
// Paints absolute coordinates on a 64x64 canvas; the parent blits it at
// {0, 0}. The part's stream is the main seed stream (passed as the part
// seed); the species' detail draws use the derived stream passed as the
// detailState uniform.

asset flower {
  size 64x64
  origin 0,0
  variants 8

  input u32   species = 0
  input f32   height = 15.0
  input u32   heightN = 0
  input color leafDark = #365c38
  input color leafMid = #4e7c4a
  input color leafLight = #6c9a62
  input color bloom = #e89648
  input u32   detailState = 0

  // The pointed leaf of the reference PaPlant::draw: a leaning diamond with
  // a lit inner face and a midrib. Takes absolute canvas coordinates.
  leaf(x: f32, y: f32, rx: f32, ry: f32, lean: f32, c: color) {
    poly(c, x - rx, y, x + lean, y - ry, x + rx, y, x + lean, y + ry)
    poly(shade(c, 26), x - rx * 0.5, y - 0.4, x + lean * 0.45, y - ry * 0.55, x + rx * 0.35, y - 0.4, x + lean * 0.45, y + ry * 0.55)
    line(x - rx * 0.7, y + ry * 0.3, x + rx * 0.7, y - ry * 0.3, 1, shade(c, -32))
  }

  draw {
    rim = -12.0
    crown = rim - height
    dState = detailState

    if (species == 0) {
      // Broadleaf stem: leaf pairs along a stem, a lit crown leaf.
      pairs = 3 + index(4)
      rect(31.0, crown + 56, 2.0, rim - crown, shade(leafMid, -28))
      pair = 0
      while (pair < pairs) {
        y = rim - 4.0 - pair * max(3.0, height / pairs)
        size = 4.4 - 0.8 * (pair % 2)
        side = -1
        if (pair % 2 == 1) { side = 1 }
        lx = side * size * 0.7
        lc = leafMid
        if (pair % 2 == 1) { lc = shade(leafMid, 12) }
        leaf(32 + lx, y + 56, size, size * 0.46, side * 1.6, lc)
        pair = pair + 1
      }
      leaf(32, crown - 1 + 56, 3.6, 3.4, 0, leafLight)
    } else if (species == 1) {
      // Spiky blades: pixel-stepped blades leaning from the detail stream.
      blades = 5 + index(5)
      blade = 0
      while (blade < blades) {
        stream_push(dState)
        lean = range(-1.0, 1.0)
        tallN = index(5)
        tall = height * (0.6 + 0.4 * tallN / 4.0)
        tipX = lean * tall * 0.42
        bladeColor = leafMid
        if (blade % 3 == 0) { bladeColor = shade(leafDark, 10) }
        dState = seed
        stream_pop()
        steps = i32trunc(tall)
        step = 0
        while (step < steps) {
          t = step / tall
          x = tipX * t
          y = rim - 2.0 - step
          pixel(round(x) + 32, i32trunc(y) + 56, shade(bladeColor, i32trunc(18.0 * t)))
          if (step % 2 == 1) {
            pixel(round(x) + 33, i32trunc(y) + 56, shade(bladeColor, -14))
          }
          step = step + 1
        }
        blade = blade + 1
      }
    } else if (species == 2) {
      // Succulent rosette: concentric ring ovals and an eight-petal ring
      // around the rim; the petals jitter on the detail stream.
      radius = 6.0 + index(4)
      centre = rim - 3.0 - radius * 0.6
      ring = 3
      while (ring >= 0) {
        r = radius * (0.4 + 0.2 * ring)
        ringColor = leafMid
        if (ring % 2 == 1) { ringColor = shade(leafDark, 8) }
        oval(32.0, centre + 56, r, r * 0.72, ringColor)
        oval(32.0, centre - 0.5 + 56, r * 0.62, r * 0.42, shade(ringColor, 22))
        ring = ring - 1
      }
      oval(32.0, centre - 0.5 + 56, 1.6, 1.2, leafLight)
      petal = 0
      while (petal < 8) {
        stream_push(dState)
        angle = petal * 3.14159265359 / 4.0
        if (unit() >= 0.5) { angle = angle + 0.2 }
        dState = seed
        stream_pop()
        petalY = centre + sin(angle) * radius * 0.72
        pixel(32 + round(cos(angle) * radius), round(petalY) + 56, shade(leafDark, -18))
        petal = petal + 1
      }
    } else if (species == 3) {
      // Bushy canopy: a stem and scattered clumps of leaves.
      clumps = 6 + index(5)
      rect(31.0, crown + 56, 2.0, rim - crown - 4, shade(leafDark, 12))
      clump = 0
      while (clump < clumps) {
        stream_push(dState)
        y = crown + 2.0 + index(11 + heightN)
        x = range(-1.0, 1.0) * (2.0 + (y - rim) * -0.35)
        r = 2.4 + index(3)
        lean = range(-1.4, 1.4)
        dState = seed
        stream_pop()
        lc = leafMid
        if (clump % 3 == 0) { lc = shade(leafLight, -10) }
        leaf(32 + x, y + 56, r, r * 0.9, lean, lc)
        clump = clump + 1
      }
    } else if (species == 4) {
      // Flowering plant: leaf pairs, then five-petal blooms.
      pairs = 2 + index(3)
      rect(31.0, crown + 58, 2.0, rim - crown - 2, shade(leafMid, -24))
      pair = 0
      while (pair < pairs) {
        y = rim - 5.0 - pair * max(3.0, height / (pairs + 1))
        side = -1
        if (pair % 2 == 1) { side = 1 }
        lx = side * 3.4
        leaf(32 + lx, y + 56, 3.8, 2.0, side * 1.4, leafMid)
        pair = pair + 1
      }
      flowers = 2 + index(3)
      flower = 0
      while (flower < flowers) {
        stream_push(dState)
        fx = range(-4.0, 4.0)
        fy = crown + range(0.0, 4.0)
        dState = seed
        stream_pop()
        // five petals at the constant angles 2*pi*k/5
        pixel(32 + round(fx + 1.8), round(fy + 0.0) + 56, bloom)
        pixel(32 + round(fx + 0.55623059), round(fy + 1.71190173) + 56, bloom)
        pixel(32 + round(fx - 1.45623059), round(fy + 1.05801345) + 56, bloom)
        pixel(32 + round(fx - 1.45623059), round(fy - 1.05801345) + 56, bloom)
        pixel(32 + round(fx + 0.55623059), round(fy - 1.71190173) + 56, bloom)
        pixel(32 + round(fx), round(fy) + 56, shade(bloom, -46))
        flower = flower + 1
      }
    } else {
      // Arching fronds: pixel-stepped arcs shaped by sin(t * pi * 0.85),
      // each frond leaning from the detail stream.
      fronds = 4 + index(3)
      frond = 0
      while (frond < fronds) {
        stream_push(dState)
        lean = range(-1.0, 1.0)
        arc = height * (0.5 + 0.5 * index(4) / 3.0)
        dState = seed
        stream_pop()
        frondColor = leafMid
        if (frond % 2 == 0) { frondColor = shade(leafDark, 10) }
        steps = i32trunc(arc)
        step = 0
        while (step < steps) {
          t = step / arc
          x = lean * arc * 0.5 * sin(t * 3.14159265359 * 0.85)
          y = rim - 2.0 - step
          pixel(32 + round(x), i32trunc(y) + 56, shade(frondColor, i32trunc(20.0 * t)))
          if (step > 2 && step % 3 != 1) {
            pixel(32 + round(x) - 1, i32trunc(y) - 1 + 56, shade(frondColor, -12))
            pixel(32 + round(x) + 1, i32trunc(y) + 56, shade(frondColor, 10))
          }
          step = step + 1
        }
        frond = frond + 1
      }
    }
  }
}
