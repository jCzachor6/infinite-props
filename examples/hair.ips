// hair.ips — the hairstyle part of the QuantSpace character portrait
// (1:1 port of PaPortrait.cpps drawHair). Paints absolute coordinates on a
// 64x64 canvas; the parent blits it at {0, 0}, so the pixels land exactly
// where the reference paints them. The style index and colours arrive as
// uniforms; the part consumes no RNG.

asset hair {
  size 64x64
  origin 0,0
  variants 8

  input u32   style = 0
  input color color = #221e22
  input color accent = #90c5b9

  draw {
    if (style == 0) {
      // Cropped
      poly(color, 19, 23, 20, 16, 25, 11, 37, 11, 44, 17, 44, 24, 39, 20, 35, 17, 26, 18)
    } else if (style == 1) {
      // Swept
      poly(color, 19, 27, 18, 18, 23, 11, 37, 9, 44, 15, 45, 24, 39, 20, 36, 16, 27, 23, 23, 23)
    } else if (style == 2) {
      // Curls: a 3x5 grid of ovals with a checker of lighter curls
      row = 0
      while (row < 3) {
        col = 0
        while (col < 5) {
          x = col * 5.0 + 21.0
          y = row * 4.0 + 14.0
          if (col == 2) {
            y = y - 3.0
          }
          temp = color
          if ((col + row) % 2 == 0) {
            temp = color.shade(color, 12)
          }
          oval(x, y, 4.0, 4.0, temp)
          col = col + 1
        }
        row = row + 1
      }
    } else if (style == 3) {
      // Bob
      poly(color, 18, 39, 18, 17, 23, 11, 38, 11, 45, 19, 46, 39, 41, 42, 40, 21, 33, 18, 25, 23, 23, 40)
    } else if (style == 4) {
      // Ponytail
      poly(color, 20, 26, 19, 17, 25, 11, 38, 12, 44, 19, 43, 28, 40, 20, 29, 17, 24, 23)
      rect(45.0, 22.0, 4.0, 2.0, accent)
    } else if (style == 5) {
      // Long
      poly(color, 16, 48, 18, 19, 24, 11, 38, 11, 44, 19, 48, 49, 41, 46, 39, 22, 33, 17, 25, 24, 23, 46)
    } else {
      if (style == 6) {
        // Mohawk: a spiked crest, shaved sides
        rect(28.0, 10.0, 8.0, 10.0, color)
        poly(color, 24, 14, 30, 3, 27, 12)
        poly(color.shade(color, 10), 28, 14, 34, 2, 31, 12)
        poly(color, 32, 14, 38, 4, 35, 12)
        poly(color.shade(color, -8), 26, 14, 32, 6, 29, 12)
      } else if (style == 7) {
        // Topknot: swept base, a bun and an accent tie
        poly(color, 20, 16, 22, 9, 42, 9, 44, 17, 40, 15, 24, 15)
        oval(32.0, 5.0, 4.0, 4.0, color)
        oval(31.0, 4.0, 2.0, 2.0, color.shade(color, 14))
        rect(28.0, 8.0, 8.0, 2.0, accent)
      } else if (style == 8) {
        // Afro: a big textured cloud
        oval(32.0, 13.0, 16.0, 14.0, color)
        oval(25.0, 9.0, 4.0, 4.0, color.shade(color, -12))
        oval(39.0, 11.0, 4.0, 4.0, color.shade(color, -12))
        oval(32.0, 5.0, 4.0, 4.0, color.shade(color, 8))
        oval(20.0, 16.0, 3.0, 3.0, color.shade(color, -8))
        oval(44.0, 16.0, 3.0, 3.0, color.shade(color, -8))
      } else if (style == 9) {
        // Pigtails: a cap and two buns with accent ties
        poly(color, 22, 16, 25, 9, 39, 9, 42, 16, 40, 14, 24, 14)
        oval(17.0, 19.0, 4.0, 4.0, color)
        oval(16.0, 18.0, 2.0, 2.0, color.shade(color, 12))
        rect(14.0, 18.0, 4.0, 2.0, accent)
        oval(47.0, 19.0, 4.0, 4.0, color)
        oval(46.0, 18.0, 2.0, 2.0, color.shade(color, 12))
        rect(44.0, 18.0, 4.0, 2.0, accent)
      } else {
        // Side-sweep
        poly(color, 16, 20, 20, 8, 44, 7, 46, 22, 40, 26, 24, 28, 18, 26)
        line(24.0, 12.0, 30.0, 24.0, 1, color.shade(color, 14))
      }
    }

    // Hair highlights (painted over the style, as in the reference)
    line(24.0, 15.0, 30.0, 13.0, 2, color.shade(color, 22))
    if (style == 3 || style == 5) {
      line(20.0, 28.0, 19.0, 42.0, 1, color.shade(color, 17))
      line(43.0, 30.0, 44.0, 41.0, 1, color.shade(color, -18))
    }
  }
}
