// portrait.ips — a 1:1 port of QuantSpaces character portrait generation
// (PaCharacter::generate + PaPortrait::generate), composed from the hair
// and eyes parts. Every constant, coordinate, RNG draw order and paint
// order matches base-code/QuantSpace/src/procedural/characters/.

import hair from "hair.ips"
import eyes from "eyes.ips"

asset portrait {
  size 64x64
  origin 32,60
  variants 8

  output point pupilCenter

  palette skins = [#f5cdaa, #e4b18b, #d19770, #bb7f59, #9e6547, #7e4f3b, #654031, #e8bea6]
  palette hairs = [#221e22, #452c21, #694328, #a6572b, #cda45b, #e2cc9b, #777479, #d0d1c7]
  palette eyeColors = [#4b6f7d, #4b6948, #69482b, #342e27, #838c8f]
  palette clothings = [#37576d, #446d65, #7d4f40, #6d6384, #7b8376, #434e5c]
  palette accents = [#90c5b9, #e0a14a]

  // PaCharacterAge::sample — the inverse CDF of the broad discrete Gaussian
  // over ages 18..40 (PaCharacterAge.cpp), a single uniform draw.
  ageFromUnit(u: f32) -> i32 {
    age = 40
    if (u < 0.9771957583125306) { age = 39 }
    if (u < 0.9503257949912918) { age = 38 }
    if (u < 0.9191560922331614) { age = 37 }
    if (u < 0.8835591743575805) { age = 36 }
    if (u < 0.8435364837855391) { age = 35 }
    if (u < 0.7992354037148802) { age = 34 }
    if (u < 0.7509588236836681) { age = 33 }
    if (u < 0.6991656137878286) { age = 32 }
    if (u < 0.6444610818061037) { age = 31 }
    if (u < 0.5875773690086589) { age = 30 }
    if (u < 0.529344697836418) { age = 29 }
    if (u < 0.47065530216358203) { age = 28 }
    if (u < 0.412422630991341) { age = 27 }
    if (u < 0.35553891819389627) { age = 26 }
    if (u < 0.3008343862121714) { age = 25 }
    if (u < 0.2490411763163319) { age = 24 }
    if (u < 0.20076459628511978) { age = 23 }
    if (u < 0.15646351621446092) { age = 22 }
    if (u < 0.1164408256424196) { age = 21 }
    if (u < 0.08084390776683863) { age = 20 }
    if (u < 0.049674205008708304) { age = 19 }
    if (u < 0.02280424168746939) { age = 18 }
    return age
  }

  draw {
    // ---- identity (PaCharacter::generate); RNG order preserved ----
    stream_push(hash(seed ^ 0xc4a7ac7e))
    female = index(2)
    index(16)
    index(16)
    // Age: the discrete Gaussian chain over 18..40 (PaCharacterAge.cpp).
    age = ageFromUnit(unit())
    skinC = skins[index(8)]
    hairC = hairs[index(8)]
    eyeC = eyeColors[index(5)]
    clothingC = clothings[index(6)]
    accentC = accents[index(2)]
    hairstyle = index(3)
    // map to the HairStyle enum: females get Bob/Ponytail/Long (3..5),
    // males get Cropped/Swept/Curls (0..2)
    if (female) {
      hairstyle = hairstyle + 3
    }
    faceWidth = index(3)
    freckles = index(4) == 0
    beard = index(4) == 0 && female == 0

    // ---- original hairstyles: ~40% get one instead of the games style ----
    if (index(5) < 2) {
      hairstyle = index(5) + 6
    }

    // ---- head-shape variation (after the identity draws) ----
    shape = index(3)
    jaw = shape - 1
    if (female) {
      jaw = jaw - 2
    } else {
      jaw = jaw + 2
    }

    // ---- derived values ----
    w = faceWidth + 11.0
    shoulder = 21.0
    if (female == 1) {
      shoulder = 17.0
    }
    brow = color.shade(hairC, -13)

    // ---- background halo ----
    y = 0
    while (y < 64) {
      x = 0
      while (x < 64) {
        dx = x - 30.0
        dy = y - 25.0
        t = 1.0 - sqrt(dx * dx + dy * dy) / 45.0
        if (t < 0.0) {
          t = 0.0
        }
        c = color.mix(#141d27, #314952, t)
        if ((x + y) % 4 == 0) {
          c = color.shade(c, 2)
        }
        pixel(x, y, c)
        x = x + 1
      }
      y = y + 1
    }

    // ---- corner accents ----
    line(5.0, 9.0, 5.0, 4.0, 1, #576f77)
    line(5.0, 4.0, 12.0, 4.0, 1, #576f77)
    line(58.0, 49.0, 58.0, 56.0, 1, #576f77)
    line(58.0, 56.0, 52.0, 56.0, 1, #576f77)

    // ---- long-hair backdrop and ponytail (behind the jacket) ----
    if (hairstyle == 3 || hairstyle == 5) {
      poly(color.shade(hairC, -16), 29 - w, 20, 35 + w, 20, 36 + w, 46, 28 - w, 46)
    }
    if (hairstyle == 4) {
      oval(46.0, 30.0, 6.0, 15.0, color.shade(hairC, -12))
    }

    // ---- jacket, shoulders, collar ----
    poly(#1b1e25, 11, 64, 32 - shoulder, 53, 25, 48, 39, 48, 32 + shoulder, 53, 56, 64)
    poly(clothingC, 13, 64, 33 - shoulder, 54, 26, 49, 38, 49, 31 + shoulder, 54, 54, 64)
    poly(color.shade(clothingC, -19), 37, 50, 31 + shoulder, 54, 54, 64, 35, 64)

    // ---- neck ----
    rect(27.0, 40.0, 10.0, 13.0, color.shade(skinC, -32))
    rect(28.0, 41.0, 6.0, 10.0, skinC)

    // ---- collar ----
    poly(color.shade(clothingC, 23), 25, 48, 31, 54, 26, 57, 22, 50)
    poly(color.shade(clothingC, 10), 39, 48, 32, 54, 37, 57, 42, 51)

    // ---- zipper and badges ----
    line(31.0, 55.0, 31.0, 63.0, 1, #1b1e25)
    line(32.0, 57.0, 32.0, 63.0, 1, accentC)
    rect(18.0, 57.0, 5.0, 2.0, accentC)
    rect(42.0, 58.0, 5.0, 3.0, #1b1e25)
    rect(43.0, 58.0, 3.0, 1.0, #b8c6c1)

    // ---- outfit variation (after the identity draws) ----
    outfit = index(4)
    if (outfit == 1) {
      // a lighter chest stripe
      rect(26.0, 55.0, 12.0, 2.0, color.mix(clothingC, color.shade(clothingC, 20), 0.35))
    }
    if (outfit == 2) {
      // two dark chest pockets
      rect(20.0, 58.0, 6.0, 4.0, color.shade(clothingC, -25))
      rect(38.0, 58.0, 6.0, 4.0, color.shade(clothingC, -25))
    }
    if (outfit == 3) {
      // accent lapels on the collar
      poly(accentC, 25, 48, 31, 54, 28, 52, 24, 49)
      poly(accentC, 39, 48, 32, 54, 36, 52, 40, 49)
    }

    // ---- ears ----
    oval(32.0 - w, 29.0, 3.0, 5.0, color.shade(skinC, -32))
    oval(32.0 + w, 29.0, 3.0, 5.0, color.shade(skinC, -32))

    // ---- face planes ----
    poly(#1b1e25, 32 - w, 17, 26, 12, 38, 12, 32 + w, 19, 31 + w, 35, 38 + jaw, 43, 30, 46, 23 - jaw, 40, 32 - w, 31)
    poly(skinC, 33 - w, 18, 27, 14, 37, 14, 31 + w, 20, 31 + w, 34, 37 + jaw, 41, 30, 44, 24 - jaw, 39, 33 - w, 30)
    poly(color.shade(skinC, -32), 37, 16, 31 + w, 20, 31 + w, 34, 37 + jaw, 41, 31, 44, 35, 36)
    poly(color.shade(skinC, 17), 24, 21, 29, 17, 32, 18, 29, 26, 24, 28)
    rect(24.0, 31.0, 5.0, 3.0, color.shade(skinC, 17))
    rect(35.0, 31.0, 5.0, 3.0, color.mix(skinC, color.shade(skinC, -32), 0.4))

    // ---- brows ----
    line(23.0, 25.0, 28.0, 24.0, 1, brow)
    line(35.0, 24.0, 40.0, 25.0, 1, brow)

    // ---- eyes (part: whites, pupils, glints; the pupil anchor surfaces
    //      through eyes.outputs.pupil) ----
    eyes.draw(seed ^ 0x517cc1b7, v, a, at = {0, 0}, iris = eyeC)
    // part.get.* reads the most recently called part (spec 9.9): the pupil
    // anchor must be captured before the hair call.
    pupilCenter = eyes.outputs.pupil

    // ---- nose ----
    line(32.0, 27.0, 31.0, 33.0, 1, color.shade(skinC, -32))
    line(31.0, 33.0, 34.0, 34.0, 1, color.shade(skinC, -46))
    pixel(31, 31, color.shade(skinC, 17))

    // ---- mouth ----
    line(28.0, 37.0, 35.0, 37.0, 1, color.mix(skinC, #723434, 0.52))
    line(29.0, 39.0, 34.0, 39.0, 1, color.shade(skinC, 17))

    // ---- beard (male only) ----
    if (beard) {
      poly(color.mix(hairC, skinC, 0.22), 24, 34, 27, 38, 32, 40, 38, 35, 38, 40, 32, 44, 26, 40)
      line(28.0, 37.0, 34.0, 37.0, 1, color.shade(hairC, -18))
    }

    // ---- freckles ----
    if (freckles) {
      pixel(24, 32, color.shade(skinC, -47))
      pixel(27, 33, color.shade(skinC, -47))
      pixel(37, 33, color.shade(skinC, -47))
      pixel(40, 32, color.shade(skinC, -47))
    }

    // ---- hairstyle (part: paints over the face; call order is paint order)
    hair.draw(seed ^ 0x9e3779b9, v, a, at = {0, 0}, style = hairstyle, color = hairC, accent = accentC)

  }
}
