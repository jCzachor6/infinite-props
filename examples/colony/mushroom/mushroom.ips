// One complete mushroom: the stem is drawn first, then the cap is placed on
// the stem's `top` anchor, read in this asset's coordinates.

import stem from "stem.ips"
import cap from "cap.ips"

asset mushroom { size 16x22
  origin 8, 22
  input color tint = #c8463c
  input i32 height = 8
  output point peak

  draw {
    stem.draw(seed, at = {8, 22}, height = height)
    top = stem.outputs.top
    cap.draw(hash(seed ^ 7), at = {top.x, top.y + 1}, tint = tint)
    peak = cap.outputs.peak
  }
}
