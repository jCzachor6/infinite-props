material Bark {
  base = #5a4230 to #7a5c40 with gaussian(mean = 0.5, sigma = 0.18)
  shadow = #2a1a10 to #3a2618
  highlight = #9a7a54
  edge = #1f140c
  taper = 0.5 to 0.8
  edge_width = 1
}

material Leaves {
  base = #2a6a44 to #7ab23c with gaussian(mean = 0.5, sigma = 0.2)
  shadow = #1a4028
  highlight = #a8d878
  edge = #14301c
  taper = 1.0
  edge_width = 0
}
