material Bark {
  base = #5a4230 to #7a5c40 with gaussian(mean = 0.5, sigma = 0.18)
  // Shades follow the rolled base, so a light trunk keeps a matching shadow.
  shadow = color.mix(base, #000000, 0.45)
  highlight = color.mix(base, #ffffff, 0.3)
  edge = #1f140c
  taper = 0.5 to 0.8
  edge_width = 1
}

material Leaves {
  base = #2a6a44 to #7ab23c with gaussian(mean = 0.5, sigma = 0.2)
  shadow = #1a4028
  highlight = #a8d878
}
