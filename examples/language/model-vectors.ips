// vec3 values: points and directions in space.
import grid from "skins/grid.ips"

asset roof {
  size 24x16x16
  const vec3 up = {0, 1, 0}
  const vec3 drift = vec3.normalize({1, 0, 1}) * 0.5   // computed while compiling

  render {
    tile = skin.crisp(grid.draw(1))

    // The corners of a floor, and a ridge above the middle of two sides.
    a = {-10, 0, 6}
    b = {10, 0, 6}
    c = {10, 0, -6}
    d = {-10, 0, -6}
    e = lerp(a, d, 0.5) + up * 9.0
    f = lerp(b, c, 0.5) + up * 9.0
    quad(a, b, f, e, tile)                           // the front slope
    quad(c, d, e, f, tile)                           // the back slope
    tri(b, c, f, tile)                               // the gables
    tri(d, a, e, tile)

    // What a slope looks like in numbers.
    length = vec3.len(e - a)                         // from the eaves to the ridge
    out = vec3.normalize(vec3.cross(b - a, e - a))   // the way the front slope faces
    steep = vec3.dot(out, up)                        // 1 would be a flat roof

    // `to` draws one point between two ends: a chimney somewhere on the ridge.
    spot = e to f
    foot = {spot.x, spot.y - 2.0, spot.z} + drift
    cylinder(foot, 1.5, 2.0 + length * 0.25 * steep, 8, tile)
  }
}
