asset listMethods {
  size 1x1
  const list<i32> fixed = [3, 1, 3, 2].distinct().sort()
  output list point values
  output point counts

  ordered(items: list<i32>) -> list<i32> {
    return items.distinct().sort()
  }

  draw {
    original = [3, 1, 3, 2]
    unique = original.distinct() // [3, 1, 2]; original remains unchanged
    sorted = ordered(original) // [1, 2, 3]
    for i in 0..list.len(unique) {
      values = {unique[i], sorted[i]}
    }
    counts = {list.len(original), list.len(fixed)}
    colors = [#112233ff, #11223300, #112233ff].distinct().sort()
    pixel(0, 0, colors[1])
  }
}
