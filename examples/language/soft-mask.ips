asset softMask {
    size 96x64
    input f32 sigma = 2.0

    region(cx: f32) -> mask {
        layer shape {
            oval(cx, 32, 12, 15, #ffffff)
            rect(cx - 17, 29, 34, 6, #ffffff)
        }
        return mask.from(shape)
    }

    draw {
        rect(0, 0, 96, 64, #182332)
        for x in 0..12 { rect(x * 8, 0, 1, 64, #243342) }
        for y in 0..8 { rect(0, y * 8, 96, 1, #243342) }
        surface.paint(region(24), #64d9cc, blend = surface.source_over)
        softRegion = region(72).blur(sigma = sigma)
        clip(softRegion) {
            for y in 0..64 {
                tone = #50b8c6 to #f0dc8c
                rect(48, y, 48, 1, tone)
            }
        }
    }
}
