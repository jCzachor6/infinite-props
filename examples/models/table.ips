// A table, one unit to a centimetre: four turned legs, each a part with a
// seed of its own, under a top of planks with rounded edges. The legs say
// where they end, and the top sits on the highest. The game reads `top`,
// where things stand, and `colliders`, the top and the legs.
import leg from "parts/turned-leg.ips"
import wood from "skins/oak.ips"

asset table {
  size 160x80x90
  scale 100

  input color stain = #8a5a2b

  output point3d top
  output list box3d colliders

  render {
    root = seed.initial()
    w = roll(root.fork("width"), 110.0, 150.0)
    d = roll(root.fork("depth"), 65.0, 85.0)
    tall = roll(root.fork("height"), 70.0, 76.0)
    inset = roll(root.fork("inset"), 6.0, 12.0)
    surface = 0.0
    for i in 0..4 {
      x = (float(i % 2) - 0.5) * (w - inset * 2.0)
      z = (float(i / 2) - 0.5) * (d - inset * 2.0)
      place(at = {x, 0, z}, yaw = float(i) * 90.0) {
        leg.render(root.fork("leg").fork(i), height = tall, tint = stain)
        end = leg.outputs.top
        surface = max(surface, end.y)
      }
      colliders = {{x, 0, z}, {6, tall, 6}}
    }
    planks = wood.draw(root.fork("top"), tint = stain)
    box({0, surface, 0}, {w, 4, d}, 1.2, planks)
    top = {0, surface + 4.0, 0}
    colliders = {{0, surface, 0}, {w, 4, d}}
  }
}
