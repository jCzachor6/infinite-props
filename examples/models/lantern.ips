// A lantern, one unit to a centimetre: an iron frame, glass panes, a candle
// and its flame. The seed picks four or six sides, the proportions, the roof
// and the handle. The iron's maps make it shine where it is bare and go dull
// where it has rusted, the panes blend over the candle, and the flame glows
// through them; `rust` fixes how rusted the iron is.
import iron  from "skins/wrought.ips"
import glass from "skins/pane.ips"
import fire  from "skins/flame.ips"
import wax   from "skins/wax.ips"

asset lantern {
  size 30x50x30
  scale 100

  input f32 rust = 0.4                   // 0 clean iron, 1 rusted through

  render {
    root = seed.initial()

    // Proportions.
    sides = choose(root.fork("sides"), 4, 4, 6)
    r = roll(root.fork("radius"), 8.0, 11.0)         // from the axis to a corner
    h = roll(root.fork("height"), 17.0, 25.0)        // the glass
    plinth = roll(root.fork("plinth"), 2.5, 4.0)
    roof = choose(root.fork("roof"), 0, 1, 2)        // pyramid, stepped, dome
    turn = 180.0 / float(sides)                      // a face, not a corner, in front

    // Skins.
    // Two texels to a centimetre: a hand-sized pattern on a hand-sized thing.
    metal = skin.density(iron.draw(root.fork("iron"), rust = rust), 2.0)
    pane = skin.blend(skin.two_sided(skin.fit(glass.draw(root.fork("glass")))))
    flame = skin.emission(skin.fit(fire.draw(root.fork("flame"))), roll(root.fork("glow"), 1.5, 2.5))
    candle = skin.fit(wax.draw(root.fork("wax")))

    // The plinth, the cage and the cap all share one polygon.
    place(yaw = turn) {
      cylinder({0, 0, 0}, r + 1.5, plinth, sides, metal)
      cylinder({0, plinth + h, 0}, r + 1.0, 1.5, sides, metal)
    }
    apothem = r * cos(3.14159265 / float(sides))
    side = 2.0 * r * sin(3.14159265 / float(sides))
    for j in 0..sides {
      place(yaw = 360.0 * float(j) / float(sides)) {
        wall(apothem, side, plinth, h, metal, pane)
      }
    }

    // The candle and its flame.
    tall = roll(root.fork("candle"), 5.0, h * 0.55)
    cylinder({0, plinth, 0}, 1.7, tall, 12, candle)
    place(at = {0, plinth + tall + 0.3, 0}, scale = {0.6, 1.15, 0.6}) {
      sphere({0, 0, 0}, 1.6, 12, 8, flame)
    }

    // The roof and the ring to carry it by.
    top = plinth + h + 1.5
    rise = cap(roof, top, r + 2.0, sides, turn, metal)
    ring(top + rise, metal)
  }

  // One side of the cage: the pane, a post at its right corner and the rails.
  wall(apothem: f32, side: f32, plinth: f32, h: f32, metal: skin, pane: skin) {
    quad({-side * 0.5, plinth, apothem - 0.4}, {side * 0.5, plinth, apothem - 0.4},
         {side * 0.5, plinth + h, apothem - 0.4}, {-side * 0.5, plinth + h, apothem - 0.4}, pane)
    box({side * 0.5, plinth, apothem}, {1.2, h, 1.2}, 0.2, metal)
    box({0, plinth, apothem}, {side, 1.0, 0.8}, metal)
    box({0, plinth + h - 1.0, apothem}, {side, 1.0, 0.8}, metal)
  }

  // The roof; returns its height.
  cap(style: i32, top: f32, reach: f32, sides: i32, turn: f32, metal: skin) -> f32 {
    if (style == 0) {
      place(yaw = turn) { cone({0, top, 0}, reach, 1.2, reach * 0.8, sides, metal) }
      return reach * 0.8
    }
    if (style == 1) {
      place(yaw = turn) {
        cylinder({0, top, 0}, reach, 1.5, sides, metal)
        cylinder({0, top + 1.5, 0}, reach * 0.7, 2.0, sides, metal)
        cone({0, top + 3.5, 0}, reach * 0.45, 1.0, reach * 0.4, sides, metal)
      }
      return 3.5 + reach * 0.4
    }
    lathe({0, top, 0}, [{0, 0}, {reach, 0}, {reach * 0.92, reach * 0.3}, {reach * 0.7, reach * 0.58},
                        {reach * 0.35, reach * 0.78}, {1.2, reach * 0.82}, {0, reach * 0.82}], 20, 40.0, metal)
    return reach * 0.82
  }

  // A finial and a ring standing on it.
  ring(at: f32, metal: skin) {
    cylinder({0, at, 0}, 1.0, 1.5, 8, metal)
    place(at = {0, at + 1.5 + 2.6, 0}, pitch = 90.0) {
      band({0, -0.5, 0}, 2.6, 2.6, 1.0, 16, skin.two_sided(metal))
    }
  }
}
