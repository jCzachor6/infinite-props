get_filename_component(REPO "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED TOOLS)
    message(FATAL_ERROR "Pass -DTOOLS=/path/to/built/tools")
endif()
if(CMAKE_HOST_WIN32)
    set(SUFFIX .exe)
endif()
set(WORK "${TOOLS}/smoke")
file(MAKE_DIRECTORY "${WORK}")
function(run_tool name)
    execute_process(COMMAND "${TOOLS}/${name}${SUFFIX}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "${name}: ${status}\n${stdout}\n${stderr}")
    endif()
    set(LAST_STDOUT "${stdout}" PARENT_SCOPE)
endfunction()
foreach(asset portrait plant)
    run_tool(ipc "${REPO}/examples/${asset}.ips" -o "${WORK}/${asset}.iprop")
    run_tool(ipval "${WORK}/${asset}.iprop")
    run_tool(ipgen "${WORK}/${asset}.iprop" --seed 26 -o "${WORK}/${asset}.png")
    run_tool(ipdis "${WORK}/${asset}.iprop" --source)
    run_tool(ipc "${REPO}/examples/${asset}.ips" -o "${WORK}/${asset}-debug.iprop" --debug)
    run_tool(ipdis "${WORK}/${asset}-debug.iprop" --source)
    if(NOT LAST_STDOUT MATCHES "; line [1-9]")
        message(FATAL_ERROR "${asset}: --debug source map is missing")
    endif()
endforeach()
run_tool(ipa "${REPO}/tests/golden/shapes.ipa" -o "${WORK}/shapes.iprop")
run_tool(ipsheet "${WORK}/portrait.iprop" --variants 2 --seeds 2 -o "${WORK}/sheet.png")
message(STATUS "All six CLI smoke checks passed")
