if(NOT DEFINED PREFIX OR NOT DEFINED WORK)
    message(FATAL_ERROR "Pass -DPREFIX=/installed/prefix -DWORK=/temporary/work")
endif()
get_filename_component(PREFIX "${PREFIX}" ABSOLUTE)
get_filename_component(WORK "${WORK}" ABSOLUTE)
file(MAKE_DIRECTORY "${WORK}")
# Consume the source product version, so a new minor release cannot silently
# leave the relocated-package check pinned to the previous minor.
file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/../CMakeLists.txt" version_line
    REGEX "^[ ]+VERSION [0-9]+\\.[0-9]+\\.[0-9]+")
string(REGEX MATCH "[0-9]+\\.[0-9]+\\.[0-9]+" product_version "${version_line}")
if(NOT product_version)
    message(FATAL_ERROR "Cannot determine the source product version")
endif()
function(run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE status
        OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "${ARGV}\n${status}\n${stdout}\n${stderr}")
    endif()
    set(LAST_STDOUT "${stdout}" PARENT_SCOPE)
endfunction()
if(CMAKE_HOST_WIN32)
    set(suffix .exe)
    set(ENV{PATH} "${PREFIX}/bin;$ENV{PATH}")
endif()
find_package(Python3 3.10 QUIET COMPONENTS Interpreter)
if(Python3_Interpreter_FOUND)
    run("${Python3_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/language_docs.py" verify
        --output-dir "${PREFIX}/share/iprop" --compiler "${PREFIX}/bin/ipc${suffix}"
        --version "${product_version}" --against-source)
endif()
# The installed header refers to the C API guide; every guide's local links resolve.
foreach(backend capi sfml godot)
    set(guide "${PREFIX}/share/iprop/backends/${backend}/README.md")
    if(NOT EXISTS "${guide}")
        message(FATAL_ERROR "Installed SDK lacks ${guide}")
    endif()
    file(READ "${guide}" text)
    # Square brackets would break CMake list splitting; mark link targets first.
    string(REPLACE "](" "<link>" text "${text}")
    string(REGEX MATCHALL "<link>[^)#:]+" links "${text}")
    foreach(link IN LISTS links)
        string(SUBSTRING "${link}" 6 -1 target)
        if(NOT EXISTS "${PREFIX}/share/iprop/backends/${backend}/${target}")
            message(FATAL_ERROR "${guide} links to a missing ${target}")
        endif()
    endforeach()
endforeach()
foreach(asset portrait plant)
    run("${PREFIX}/bin/ipc${suffix}" "${PREFIX}/share/iprop/examples/${asset}.ips" -o "${WORK}/${asset}.iprop")
    run("${PREFIX}/bin/ipval${suffix}" "${WORK}/${asset}.iprop")
    run("${PREFIX}/bin/ipgen${suffix}" "${WORK}/${asset}.iprop" --seed 26 -o "${WORK}/${asset}.png")
    run("${PREFIX}/bin/ipdis${suffix}" "${WORK}/${asset}.iprop" --source)
    run("${PREFIX}/bin/ipc${suffix}" "${PREFIX}/share/iprop/examples/${asset}.ips"
        -o "${WORK}/${asset}-debug.iprop" --debug)
    run("${PREFIX}/bin/ipdis${suffix}" "${WORK}/${asset}-debug.iprop" --source)
    if(NOT LAST_STDOUT MATCHES "; line [1-9]")
        message(FATAL_ERROR "Installed ${asset}: --debug source map is missing")
    endif()
endforeach()
run("${PREFIX}/bin/ipa${suffix}" "${PREFIX}/share/iprop/examples/portrait.ipa" -o "${WORK}/assembled.iprop")
run("${PREFIX}/bin/ipsheet${suffix}" "${WORK}/portrait.iprop" --variants 2 --seeds 2 -o "${WORK}/sheet.png")
foreach(mode shared static)
    set(use_static OFF)
    if(mode STREQUAL "static")
        set(use_static ON)
    endif()
    set(dependency_options)
    if(DEFINED ZLIB_USE_STATIC_LIBS)
        list(APPEND dependency_options "-DZLIB_USE_STATIC_LIBS=${ZLIB_USE_STATIC_LIBS}")
    endif()
    run("${CMAKE_COMMAND}" -S "${CMAKE_CURRENT_LIST_DIR}/install-consumer" -B "${WORK}/${mode}"
        -DCMAKE_BUILD_TYPE=Release "-DCMAKE_PREFIX_PATH=${PREFIX}" -DUSE_STATIC=${use_static}
        "-DIPROP_EXPECTED_VERSION=${product_version}" ${dependency_options})
    run("${CMAKE_COMMAND}" --build "${WORK}/${mode}" --config Release --parallel 2)
    set(consumer "${WORK}/${mode}/consumer${suffix}")
    if(EXISTS "${WORK}/${mode}/Release/consumer${suffix}")
        set(consumer "${WORK}/${mode}/Release/consumer${suffix}")
    endif()
    run("${consumer}" "${WORK}/portrait.iprop")
endforeach()
run("${CMAKE_COMMAND}" -S "${PREFIX}/share/iprop/examples/c" -B "${WORK}/parameter-panel"
    -DCMAKE_BUILD_TYPE=Release "-DCMAKE_PREFIX_PATH=${PREFIX}" ${dependency_options})
run("${CMAKE_COMMAND}" --build "${WORK}/parameter-panel" --config Release --parallel 2)
run("${PREFIX}/bin/ipc${suffix}" "${PREFIX}/share/iprop/examples/recipes/24-uniform-emblem.ips"
    -o "${WORK}/parameter-panel.iprop")
set(panel_expected "program_freed=1\ninputs=3\n"
    "input=0 type=color name_bytes=6 name_hex=616363656e74 default_rgba=55bbffff\n"
    "input=1 type=f32 name_bytes=5 name_hex=7363616c65 default_bits=3f800000\n"
    "input=2 type=u32 name_bytes=7 name_hex=64656e73697479 default_bits=00000008 default_u32=8\n")
string(JOIN "" panel_expected ${panel_expected})
foreach(mode shared static)
    set(panel "${WORK}/parameter-panel/parameter_panel_${mode}${suffix}")
    if(EXISTS "${WORK}/parameter-panel/Release/parameter_panel_${mode}${suffix}")
        set(panel "${WORK}/parameter-panel/Release/parameter_panel_${mode}${suffix}")
    endif()
    run("${panel}" "${WORK}/parameter-panel.iprop")
    string(REPLACE "\r\n" "\n" panel_stdout "${LAST_STDOUT}")
    if(NOT panel_stdout STREQUAL panel_expected)
        message(FATAL_ERROR "Installed C99 panel ${mode}: wrong owned schema/defaults:\n${LAST_STDOUT}")
    endif()
    string(REPLACE "parameter_panel_" "render_inputs_" render "${panel}")
    run("${render}" "${WORK}/parameter-panel.iprop" "${WORK}/render-${mode}.pam"
        "accent=#ff8800" scale=1.5 density=3)
    file(READ "${WORK}/render-${mode}.pam" pam_header LIMIT 64)
    if(NOT LAST_STDOUT MATCHES "^image=32x32 fuel_used=[1-9]" OR NOT pam_header MATCHES "^P7\nWIDTH 32\nHEIGHT 32")
        message(FATAL_ERROR "Installed C99 render ${mode}: wrong image:\n${LAST_STDOUT}")
    endif()
endforeach()
if(EXISTS "${PREFIX}/bin/iprop_sfml${suffix}")
    run("${PREFIX}/bin/iprop_sfml${suffix}" "${WORK}/portrait.iprop" --seed 26 --export "${WORK}/sfml.png")
    file(READ "${WORK}/sfml.png" signature LIMIT 8 HEX)
    if(NOT signature STREQUAL "89504e470d0a1a0a")
        message(FATAL_ERROR "Installed SFML export is not a PNG")
    endif()
endif()
message(STATUS "Installed tools and shared/static C consumers: PASS")
