if(NOT DEFINED PREFIX OR NOT DEFINED WORK)
    message(FATAL_ERROR "Pass -DPREFIX=/installed/prefix -DWORK=/temporary/work")
endif()
get_filename_component(PREFIX "${PREFIX}" ABSOLUTE)
get_filename_component(WORK "${WORK}" ABSOLUTE)
file(MAKE_DIRECTORY "${WORK}")
# Consume the source product version, so a new minor release cannot silently
# leave the relocated-package check pinned to the previous minor.
file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/../CMakeLists.txt" version_line
    REGEX "^[ ]+VERSION [0-9]+\\.[0-9]+\\.[0-9]+")
string(REGEX MATCH "[0-9]+\\.[0-9]+\\.[0-9]+" product_version "${version_line}")
if(NOT product_version)
    message(FATAL_ERROR "Cannot determine the source product version")
endif()
function(run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE status
        OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "${ARGV}\n${status}\n${stdout}\n${stderr}")
    endif()
endfunction()
if(CMAKE_HOST_WIN32)
    set(suffix .exe)
    set(ENV{PATH} "${PREFIX}/bin;$ENV{PATH}")
endif()
foreach(asset portrait plant)
    run("${PREFIX}/bin/ipc${suffix}" "${PREFIX}/share/iprop/examples/${asset}.ips" -o "${WORK}/${asset}.iprop")
    run("${PREFIX}/bin/ipval${suffix}" "${WORK}/${asset}.iprop")
    run("${PREFIX}/bin/ipgen${suffix}" "${WORK}/${asset}.iprop" --seed 26 -o "${WORK}/${asset}.png")
    run("${PREFIX}/bin/ipdis${suffix}" "${WORK}/${asset}.iprop" --source)
endforeach()
run("${PREFIX}/bin/ipa${suffix}" "${PREFIX}/share/iprop/examples/portrait.ipa" -o "${WORK}/assembled.iprop")
run("${PREFIX}/bin/ipsheet${suffix}" "${WORK}/portrait.iprop" --variants 2 --seeds 2 -o "${WORK}/sheet.png")
foreach(mode shared static)
    set(use_static OFF)
    if(mode STREQUAL "static")
        set(use_static ON)
    endif()
    run("${CMAKE_COMMAND}" -S "${CMAKE_CURRENT_LIST_DIR}/install-consumer" -B "${WORK}/${mode}"
        -DCMAKE_BUILD_TYPE=Release "-DCMAKE_PREFIX_PATH=${PREFIX}" -DUSE_STATIC=${use_static}
        "-DIPROP_EXPECTED_VERSION=${product_version}")
    run("${CMAKE_COMMAND}" --build "${WORK}/${mode}" --config Release --parallel 2)
    set(consumer "${WORK}/${mode}/consumer${suffix}")
    if(EXISTS "${WORK}/${mode}/Release/consumer${suffix}")
        set(consumer "${WORK}/${mode}/Release/consumer${suffix}")
    endif()
    run("${consumer}" "${WORK}/portrait.iprop")
endforeach()
if(EXISTS "${PREFIX}/bin/iprop_sfml${suffix}")
    run("${PREFIX}/bin/iprop_sfml${suffix}" "${WORK}/portrait.iprop" --seed 26 --export "${WORK}/sfml.png")
    file(READ "${WORK}/sfml.png" signature LIMIT 8 HEX)
    if(NOT signature STREQUAL "89504e470d0a1a0a")
        message(FATAL_ERROR "Installed SFML export is not a PNG")
    endif()
endif()
message(STATUS "Installed tools and shared/static C consumers: PASS")
