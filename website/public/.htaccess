AddType application/wasm .wasm
AddType application/octet-stream .iprop

RewriteEngine On
RewriteCond %{HTTP_HOST} ^(www\.)?infiniteprops\.dev$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

# Every file outside assets/ keeps its name across releases: the pages,
# the WASM runtime and its worker, the showcase binaries and the manifests
# that list their sizes and hashes, the docs scripts and data. Browsers must
# revalidate them all together, or a cached file meets a newer one it
# describes or loads (a cached iprop.js and a new iprop.wasm, a cached
# butterfly-benchmark.json and new butterfly parts) and nothing renders.
# Vite's hashed files under assets/ keep the host's caching.
<If "%{REQUEST_URI} !~ m#/assets/[^/]+$#">
  <IfModule mod_expires.c>
    ExpiresActive Off
  </IfModule>
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache"
    Header unset Expires
  </IfModule>
</If>
